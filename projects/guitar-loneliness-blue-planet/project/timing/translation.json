{
  "schemaVersion": 1,
  "format": "lrc-line-timed",
  "lines": [
    {
      "startMs": 15170,
      "text": "突然下起的骤雨 讨厌没带雨伞的自己",
      "endMs": 20940,
      "durationMs": 5770
    },
    {
      "startMs": 20940,
      "text": "才懒得在乎天空的心情",
      "endMs": 24950,
      "durationMs": 4010
    },
    {
      "startMs": 24950,
      "text": "季节交换之际",
      "endMs": 28020,
      "durationMs": 3070
    },
    {
      "startMs": 28020,
      "text": "该换上什么外衣",
      "endMs": 30950,
      "durationMs": 2930
    },
    {
      "startMs": 30950,
      "text": "春天和秋天 究竟消失去了何处",
      "endMs": 34970,
      "durationMs": 4020
    },
    {
      "startMs": 34970,
      "text": "资讯时代的压力 令人喘不过气",
      "endMs": 39830,
      "durationMs": 4860
    },
    {
      "startMs": 39830,
      "text": "陷入了令人晕眩的螺旋之中",
      "endMs": 42300,
      "durationMs": 2470
    },
    {
      "startMs": 42300,
      "text": "我又到底身在何方",
      "endMs": 44750,
      "durationMs": 2450
    },
    {
      "startMs": 44750,
      "text": "明明充满如此多的",
      "endMs": 47160,
      "durationMs": 2410
    },
    {
      "startMs": 47160,
      "text": "如此多的呼吸声",
      "endMs": 50760,
      "durationMs": 3600
    },
    {
      "startMs": 50760,
      "text": "真奇怪啊 世界却悄然沉寂",
      "endMs": 55980,
      "durationMs": 5220
    },
    {
      "startMs": 55980,
      "text": "还不够 还不够",
      "endMs": 57330,
      "durationMs": 1350
    },
    {
      "startMs": 57330,
      "text": "还没有任何人发现",
      "endMs": 60170,
      "durationMs": 2840
    },
    {
      "startMs": 60170,
      "text": "杂乱无章的音色",
      "endMs": 62080,
      "durationMs": 1910
    },
    {
      "startMs": 62080,
      "text": "不成声地咆哮着",
      "endMs": 65310,
      "durationMs": 3230
    },
    {
      "startMs": 65310,
      "text": "所谓的“真实自我”",
      "endMs": 67090,
      "durationMs": 1780
    },
    {
      "startMs": 67090,
      "text": "又该让谁看见",
      "endMs": 70270,
      "durationMs": 3180
    },
    {
      "startMs": 70270,
      "text": "傻瓜如我唯有放声高歌",
      "endMs": 75380,
      "durationMs": 5110
    },
    {
      "startMs": 75380,
      "text": "对着星星倾吐一切吧",
      "endMs": 89610,
      "durationMs": 14230
    },
    {
      "startMs": 89610,
      "text": "换上伊利克斯吉他弦演奏",
      "endMs": 92710,
      "durationMs": 3100
    },
    {
      "startMs": 92710,
      "text": "也依旧不如人意",
      "endMs": 95460,
      "durationMs": 2750
    },
    {
      "startMs": 95460,
      "text": "轻轻抚摸着有些磨损的指甲",
      "endMs": 99530,
      "durationMs": 4070
    },
    {
      "startMs": 99530,
      "text": "用半径300mm的琴身拼命地拨弹着",
      "endMs": 105330,
      "durationMs": 5800
    },
    {
      "startMs": 105330,
      "text": "对于音乐而言 这里就是地球了吧",
      "endMs": 109520,
      "durationMs": 4190
    },
    {
      "startMs": 109520,
      "text": "紧握着空气 挥向天空",
      "endMs": 114370,
      "durationMs": 4850
    },
    {
      "startMs": 114370,
      "text": "什么都没有发生 我依旧如此无力",
      "endMs": 119340,
      "durationMs": 4970
    },
    {
      "startMs": 119340,
      "text": "然而 当我的这双手",
      "endMs": 121720,
      "durationMs": 2380
    },
    {
      "startMs": 121720,
      "text": "弹奏起铁弦时",
      "endMs": 125340,
      "durationMs": 3620
    },
    {
      "startMs": 125340,
      "text": "眼前仿佛就会有什么发生变化",
      "endMs": 130620,
      "durationMs": 5280
    },
    {
      "startMs": 130620,
      "text": "能不能不要再那样的耀眼夺目",
      "endMs": 134960,
      "durationMs": 4340
    },
    {
      "startMs": 134960,
      "text": "那只会更加凸显出",
      "endMs": 136690,
      "durationMs": 1730
    },
    {
      "startMs": 136690,
      "text": "我那狼狈不堪的影子 不是吗",
      "endMs": 139940,
      "durationMs": 3250
    },
    {
      "startMs": 139940,
      "text": "然而为何内心",
      "endMs": 141160,
      "durationMs": 1220
    },
    {
      "startMs": 141160,
      "text": "却忽然间变得如此炽热 难以停息",
      "endMs": 144920,
      "durationMs": 3760
    },
    {
      "startMs": 144920,
      "text": "傻瓜如我唯有放声高歌",
      "endMs": 149750,
      "durationMs": 4830
    },
    {
      "startMs": 149750,
      "text": "心脏的跳动依旧如此聒噪",
      "endMs": 162390,
      "durationMs": 12640
    },
    {
      "startMs": 162390,
      "text": "苍蓝的星球上 我依然孤独一人",
      "endMs": 167310,
      "durationMs": 4920
    },
    {
      "startMs": 167310,
      "text": "聆听了不计其数的音乐",
      "endMs": 172610,
      "durationMs": 5300
    },
    {
      "startMs": 172610,
      "text": "地球不停自转了数亿年",
      "endMs": 177280,
      "durationMs": 4670
    },
    {
      "startMs": 177280,
      "text": "哪怕只是一瞬间也够了",
      "endMs": 183300,
      "durationMs": 6020
    },
    {
      "startMs": 183300,
      "text": "敬请聆听 聆听我的声音",
      "endMs": 185390,
      "durationMs": 2090
    },
    {
      "startMs": 185390,
      "text": "我 我 我就存在于这里啊",
      "endMs": 189560,
      "durationMs": 4170
    },
    {
      "startMs": 189560,
      "text": "杂乱无章的音色",
      "endMs": 191450,
      "durationMs": 1890
    },
    {
      "startMs": 191450,
      "text": "不成声地咆哮着",
      "endMs": 194650,
      "durationMs": 3200
    },
    {
      "startMs": 194650,
      "text": "我想要有所作为",
      "endMs": 196580,
      "durationMs": 1930
    },
    {
      "startMs": 196580,
      "text": "无论成为什么人都可以",
      "endMs": 199620,
      "durationMs": 3040
    },
    {
      "startMs": 199620,
      "text": "傻瓜如我唯有放声高歌",
      "endMs": 204550,
      "durationMs": 4930
    },
    {
      "startMs": 204550,
      "text": "对着星星倾吐一切吧",
      "endMs": 228960,
      "durationMs": 24410
    }
  ]
}
