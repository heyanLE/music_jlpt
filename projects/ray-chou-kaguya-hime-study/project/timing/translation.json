{
  "schemaVersion": 1,
  "format": "lrc-line-timed",
  "lines": [
    {
      "startMs": 22470,
      "text": "和你分别之时的日期",
      "endMs": 25650,
      "durationMs": 3180
    },
    {
      "startMs": 25650,
      "text": "仿佛比记忆中还要早",
      "endMs": 29060,
      "durationMs": 3410
    },
    {
      "startMs": 29060,
      "text": "悲伤的光尘封在心底",
      "endMs": 32710,
      "durationMs": 3650
    },
    {
      "startMs": 32710,
      "text": "步履蹒跚地走到如今",
      "endMs": 37020,
      "durationMs": 4310
    },
    {
      "startMs": 37020,
      "text": "和你相伴时曾经见过",
      "endMs": 40200,
      "durationMs": 3180
    },
    {
      "startMs": 40200,
      "text": "如今却再也看不见的",
      "endMs": 43650,
      "durationMs": 3450
    },
    {
      "startMs": 43650,
      "text": "透明的彗星已然模糊",
      "endMs": 47250,
      "durationMs": 3600
    },
    {
      "startMs": 47250,
      "text": "我却依然不停在追逐",
      "endMs": 50850,
      "durationMs": 3600
    },
    {
      "startMs": 50850,
      "text": "每日每夜都唱着那首歌",
      "endMs": 54280,
      "durationMs": 3430
    },
    {
      "startMs": 54280,
      "text": "那首只在当初听过的歌",
      "endMs": 58130,
      "durationMs": 3850
    },
    {
      "startMs": 58130,
      "text": "如今的我其实并不寂寞",
      "endMs": 61520,
      "durationMs": 3390
    },
    {
      "startMs": 61520,
      "text": "因为我早已习惯了寂寞",
      "endMs": 65630,
      "durationMs": 4110
    },
    {
      "startMs": 65630,
      "text": "要走到何时要走到何地",
      "endMs": 69270,
      "durationMs": 3640
    },
    {
      "startMs": 69270,
      "text": "到底算正常还是算异常",
      "endMs": 72870,
      "durationMs": 3600
    },
    {
      "startMs": 72870,
      "text": "这些我都已经无暇考虑",
      "endMs": 76290,
      "durationMs": 3420
    },
    {
      "startMs": 76290,
      "text": "走下去就让我耗尽心力",
      "endMs": 80150,
      "durationMs": 3860
    },
    {
      "startMs": 80150,
      "text": "我也知道应该过得开心",
      "endMs": 83800,
      "durationMs": 3650
    },
    {
      "startMs": 83800,
      "text": "我也可以强颜欢笑下去",
      "endMs": 87450,
      "durationMs": 3650
    },
    {
      "startMs": 87450,
      "text": "没关系 当时那份心痛",
      "endMs": 90860,
      "durationMs": 3410
    },
    {
      "startMs": 90860,
      "text": "就算忘记也绝不会失去",
      "endMs": 95140,
      "durationMs": 4280
    },
    {
      "startMs": 95140,
      "text": "曾经一厢情愿的理想",
      "endMs": 98370,
      "durationMs": 3230
    },
    {
      "startMs": 98370,
      "text": "如今渐渐被现实掩埋",
      "endMs": 101740,
      "durationMs": 3370
    },
    {
      "startMs": 101740,
      "text": "唯有回忆在痕迹之上",
      "endMs": 105370,
      "durationMs": 3630
    },
    {
      "startMs": 105370,
      "text": "残留着隐隐约约的光",
      "endMs": 109720,
      "durationMs": 4350
    },
    {
      "startMs": 109720,
      "text": "和你分别之时的原因",
      "endMs": 112890,
      "durationMs": 3170
    },
    {
      "startMs": 112890,
      "text": "到底是为了什么来着",
      "endMs": 116330,
      "durationMs": 3440
    },
    {
      "startMs": 116330,
      "text": "悲伤的光让我的影子",
      "endMs": 119940,
      "durationMs": 3610
    },
    {
      "startMs": 119940,
      "text": "长长地延伸到路前方",
      "endMs": 123600,
      "durationMs": 3660
    },
    {
      "startMs": 123600,
      "text": "有的时候我也心血来潮",
      "endMs": 126950,
      "durationMs": 3350
    },
    {
      "startMs": 126950,
      "text": "一有空闲就沉睡在梦里",
      "endMs": 130850,
      "durationMs": 3900
    },
    {
      "startMs": 130850,
      "text": "尽管知道那明明只是梦",
      "endMs": 134230,
      "durationMs": 3380
    },
    {
      "startMs": 134230,
      "text": "我也要再次去与你相遇",
      "endMs": 138360,
      "durationMs": 4130
    },
    {
      "startMs": 138360,
      "text": "即使晴朗的天遥不可及",
      "endMs": 141990,
      "durationMs": 3630
    },
    {
      "startMs": 141990,
      "text": "即使漆黑的夜无边无际",
      "endMs": 145640,
      "durationMs": 3650
    },
    {
      "startMs": 145640,
      "text": "只要在心中浮现出繁星",
      "endMs": 149030,
      "durationMs": 3390
    },
    {
      "startMs": 149030,
      "text": "我就身处于银河的中心",
      "endMs": 152910,
      "durationMs": 3880
    },
    {
      "startMs": 152910,
      "text": "即使如今已淡忘了哭泣",
      "endMs": 156480,
      "durationMs": 3570
    },
    {
      "startMs": 156480,
      "text": "即使鞋子已换成了全新",
      "endMs": 160150,
      "durationMs": 3670
    },
    {
      "startMs": 160150,
      "text": "没关系 当时那份心痛",
      "endMs": 163570,
      "durationMs": 3420
    },
    {
      "startMs": 163570,
      "text": "就算忘记也绝不会失去",
      "endMs": 167420,
      "durationMs": 3850
    },
    {
      "startMs": 167420,
      "text": "有些话语",
      "endMs": 170190,
      "durationMs": 2770
    },
    {
      "startMs": 170190,
      "text": "当初一定很想说给你听",
      "endMs": 174700,
      "durationMs": 4510
    },
    {
      "startMs": 174700,
      "text": "或许只是很俗套的事吧",
      "endMs": 179730,
      "durationMs": 5030
    },
    {
      "startMs": 179730,
      "text": "如今看来",
      "endMs": 196330,
      "durationMs": 16600
    },
    {
      "startMs": 196330,
      "text": "当初与你的分别",
      "endMs": 199770,
      "durationMs": 3440
    },
    {
      "startMs": 199770,
      "text": "其实相遇时就已经注定",
      "endMs": 203620,
      "durationMs": 3850
    },
    {
      "startMs": 203620,
      "text": "那颗透明的彗星",
      "endMs": 206990,
      "durationMs": 3370
    },
    {
      "startMs": 206990,
      "text": "正因为透明才不会失去",
      "endMs": 211080,
      "durationMs": 4090
    },
    {
      "startMs": 211080,
      "text": "无论是对是错还是什么",
      "endMs": 214740,
      "durationMs": 3660
    },
    {
      "startMs": 214740,
      "text": "无论和他人相比算什么",
      "endMs": 218350,
      "durationMs": 3610
    },
    {
      "startMs": 218350,
      "text": "这些我都已经无心深究",
      "endMs": 221780,
      "durationMs": 3430
    },
    {
      "startMs": 221780,
      "text": "活下去就让我心满意足",
      "endMs": 225620,
      "durationMs": 3840
    },
    {
      "startMs": 225620,
      "text": "即使如今已淡忘了哭泣",
      "endMs": 229260,
      "durationMs": 3640
    },
    {
      "startMs": 229260,
      "text": "我也可以强颜欢笑下去",
      "endMs": 232900,
      "durationMs": 3640
    },
    {
      "startMs": 232900,
      "text": "没关系 当时那份心痛",
      "endMs": 236300,
      "durationMs": 3400
    },
    {
      "startMs": 236300,
      "text": "就算忘记也绝不会失去",
      "endMs": 240180,
      "durationMs": 3880
    },
    {
      "startMs": 240180,
      "text": "没关系 如今这道光芒的起点",
      "endMs": 246970,
      "durationMs": 6790
    },
    {
      "startMs": 246970,
      "text": "是你的身影",
      "endMs": 301617,
      "durationMs": 54647
    }
  ]
}
