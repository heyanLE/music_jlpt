  "lines": [
    {
      "startMs": 740,
      "text": "自由地振翅",
      "endMs": 2310,
      "durationMs": 1570
    },
    {
      "startMs": 2310,
      "text": "将这希望装填",
      "endMs": 4110,
      "durationMs": 1800
    },
    {
      "startMs": 4110,
      "text": "没关系就这样",
      "endMs": 5780,
      "durationMs": 1670
    },
    {
      "startMs": 5780,
      "text": "来吧 抓住我的手",
      "endMs": 7560,
      "durationMs": 1780
    },
    {
      "startMs": 7560,
      "text": "为今天庆祝 欢笑 热爱",
      "endMs": 10600,
      "durationMs": 3040
    },
    {
      "startMs": 10600,
      "text": "记忆会化作光芒 让心跳轰鸣吧",
      "endMs": 15230,
      "durationMs": 4630
    },
    {
      "startMs": 15230,
      "text": "即使怀抱无法消除的伤痕",
      "endMs": 17000,
      "durationMs": 1770
    },
    {
      "startMs": 17000,
      "text": "即使悔恨得无法入睡",
      "endMs": 18930,
      "durationMs": 1930
    },
    {
      "startMs": 18930,
      "text": "我仍会寻找适合你的笑容",
      "endMs": 20700,
      "durationMs": 1770
    },
    {
      "startMs": 20700,
      "text": "心怀期待吧",
      "endMs": 21900,
      "durationMs": 1200
    },
    {
      "startMs": 21900,
      "text": "向起飞的天空释放祈祷",
      "endMs": 25360,
      "durationMs": 3460
    },
    {
      "startMs": 25360,
      "text": "苏醒的生命 将活在当下",
      "endMs": 28930,
      "durationMs": 3570
    },
    {
      "startMs": 28930,
      "text": "能守护的唯有这个瞬间",
      "endMs": 32440,
      "durationMs": 3510
    },
    {
      "startMs": 32440,
      "text": "一起前进吧 相信我",
      "endMs": 36030,
      "durationMs": 3590
    },
    {
      "startMs": 36030,
      "text": "我听见了声音 奔赴未来",
      "endMs": 39660,
      "durationMs": 3630
    },
    {
      "startMs": 39660,
      "text": "这份辉煌无人能够消弭",
      "endMs": 43160,
      "durationMs": 3500
    },
    {
      "startMs": 43160,
      "text": "若能守护 那便扣下扳机吧",
      "endMs": 46720,
      "durationMs": 3560
    },
    {
      "startMs": 46720,
      "text": "为新的愿望献上祝福吧 来吧",
      "endMs": 58060,
      "durationMs": 11340
    },
    {
      "startMs": 58060,
      "text": "选择快乐的事情",
      "endMs": 59730,
      "durationMs": 1670
    },
    {
      "startMs": 59730,
      "text": "想做什么全都去做吧",
      "endMs": 61630,
      "durationMs": 1900
    },
    {
      "startMs": 61630,
      "text": "没有任何烦恼",
      "endMs": 63350,
      "durationMs": 1720
    },
    {
      "startMs": 63350,
      "text": "也无暇困惑",
      "endMs": 68410,
      "durationMs": 5060
    },
    {
      "startMs": 68410,
      "text": "愿光芒永存 击穿黑暗",
      "endMs": 71780,
      "durationMs": 3370
    },
    {
      "startMs": 71780,
      "text": "一手拿着苹果派",
      "endMs": 73270,
      "durationMs": 1490
    },
    {
      "startMs": 73270,
      "text": "仿佛能够去往任何地方",
      "endMs": 75150,
      "durationMs": 1880
    },
    {
      "startMs": 75150,
      "text": "始终无法从梦中醒来",
      "endMs": 76780,
      "durationMs": 1630
    },
    {
      "startMs": 76780,
      "text": "就这样 回过神来 用我的双翼",
      "endMs": 80530,
      "durationMs": 3750
    },
    {
      "startMs": 80530,
      "text": "破坏梦境飞向描绘的天空吧",
      "endMs": 91140,
      "durationMs": 10610
    },
    {
      "startMs": 91140,
      "text": "向起飞的天空释放祈祷",
      "endMs": 94620,
      "durationMs": 3480
