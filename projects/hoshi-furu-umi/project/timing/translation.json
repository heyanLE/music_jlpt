{
  "schemaVersion": 1,
  "format": "lrc-line-timed",
  "lines": [
    {
      "startMs": 1370,
      "text": "历经漫长岁月的流转 此刻",
      "endMs": 7250,
      "durationMs": 5880
    },
    {
      "startMs": 7250,
      "text": "我们终于辗转相遇",
      "endMs": 10810,
      "durationMs": 3560
    },
    {
      "startMs": 10810,
      "text": "来吧 希望我们不再迷失方向",
      "endMs": 15490,
      "durationMs": 4680
    },
    {
      "startMs": 15490,
      "text": "请你牵紧我的手吧",
      "endMs": 38670,
      "durationMs": 23180
    },
    {
      "startMs": 38670,
      "text": "呐 愿你可以侧耳倾听",
      "endMs": 42930,
      "durationMs": 4260
    },
    {
      "startMs": 42930,
      "text": "你能否听到星星划落而下的声音?",
      "endMs": 48360,
      "durationMs": 5430
    },
    {
      "startMs": 48360,
      "text": "朝着我更加靠近一些",
      "endMs": 52480,
      "durationMs": 4120
    },
    {
      "startMs": 52480,
      "text": "无人知晓的世界正在静静地等待",
      "endMs": 58070,
      "durationMs": 5590
    },
    {
      "startMs": 58070,
      "text": "让我们牵起手一同起舞吧",
      "endMs": 61930,
      "durationMs": 3860
    },
    {
      "startMs": 61930,
      "text": "待到启程的信号响起之后",
      "endMs": 66320,
      "durationMs": 4390
    },
    {
      "startMs": 66320,
      "text": "让我们放声歌唱 让歌声就此响彻",
      "endMs": 70940,
      "durationMs": 4620
    },
    {
      "startMs": 70940,
      "text": "那条漆黑的道路也会铺满皎洁的月光",
      "endMs": 80510,
      "durationMs": 9570
    },
    {
      "startMs": 80510,
      "text": "我的歌声能否从苍穹 大海的彼端",
      "endMs": 88100,
      "durationMs": 7590
    },
    {
      "startMs": 88100,
      "text": "就此响彻至你的身边去呢",
      "endMs": 91660,
      "durationMs": 3560
    },
    {
      "startMs": 91660,
      "text": "不论任何时候我都会在这里等待",
      "endMs": 97420,
      "durationMs": 5760
    },
    {
      "startMs": 97420,
      "text": "因为我一直都在祈祷",
      "endMs": 101090,
      "durationMs": 3670
    },
    {
      "startMs": 101090,
      "text": "你看 那璀璨夺目的星辰",
      "endMs": 107090,
      "durationMs": 6000
    },
    {
      "startMs": 107090,
      "text": "自太古之初便不曾褪色 恒久地倾洒光芒",
      "endMs": 113810,
      "durationMs": 6720
    },
    {
      "startMs": 113810,
      "text": "我与你定会抵达那里",
      "endMs": 129330,
      "durationMs": 15520
    },
    {
      "startMs": 129330,
      "text": "我的心里深藏着渴望相见的人",
      "endMs": 135020,
      "durationMs": 5690
    },
    {
      "startMs": 135020,
      "text": "就像是指南针那般",
      "endMs": 138660,
      "durationMs": 3640
    },
    {
      "startMs": 138660,
      "text": "在悄然之间睁开双眼吧",
      "endMs": 142630,
      "durationMs": 3970
    },
    {
      "startMs": 142630,
      "text": "其实眼中所见的一切并非真正的现实",
      "endMs": 148250,
      "durationMs": 5620
    },
    {
      "startMs": 148250,
      "text": "这个与你共处的世界",
      "endMs": 152340,
      "durationMs": 4090
    },
    {
      "startMs": 152340,
      "text": "早已沉眠于永恒的记忆",
      "endMs": 156580,
      "durationMs": 4240
    },
    {
      "startMs": 156580,
      "text": "让我们放声歌唱 让歌声就此响彻",
      "endMs": 161040,
      "durationMs": 4460
    },
    {
      "startMs": 161040,
      "text": "潮汐的涨落自会给我们一定指引",
      "endMs": 169660,
      "durationMs": 8620
    },
    {
      "startMs": 169660,
      "text": "哪怕曾历经过戛然而止的梦境",
      "endMs": 174440,
      "durationMs": 4780
    },
    {
      "startMs": 174440,
      "text": "也没关系 我不会让你孤身一人",
      "endMs": 179390,
      "durationMs": 4950
    },
    {
      "startMs": 179390,
      "text": "不论多少次",
      "endMs": 181620,
      "durationMs": 2230
    },
    {
      "startMs": 181620,
      "text": "我们都会因为彼此的引力而相互吸引",
      "endMs": 189750,
      "durationMs": 8130
    },
    {
      "startMs": 189750,
      "text": "苍穹 大海的气息 能否传达给你呢",
      "endMs": 197210,
      "durationMs": 7460
    },
    {
      "startMs": 197210,
      "text": "所谓的距离本就不存在吧",
      "endMs": 200860,
      "durationMs": 3650
    },
    {
      "startMs": 200860,
      "text": "不论何时我都一定会在某处",
      "endMs": 206800,
      "durationMs": 5940
    },
    {
      "startMs": 206800,
      "text": "静静地守望着你的一切",
      "endMs": 210400,
      "durationMs": 3600
    },
    {
      "startMs": 210400,
      "text": "来吧 将让人笑到眉眼弯弯的",
      "endMs": 213940,
      "durationMs": 3540
    },
    {
      "startMs": 213940,
      "text": "那些日子",
      "endMs": 216310,
      "durationMs": 2370
    },
    {
      "startMs": 216310,
      "text": "收集后细细编织 指引我们迈向未来之后",
      "endMs": 223180,
      "durationMs": 6870
    },
    {
      "startMs": 223180,
      "text": "与你一同感受心灵的震撼",
      "endMs": 237250,
      "durationMs": 14070
    },
    {
      "startMs": 237250,
      "text": "此刻便实现梦想 亲历这个故事吧",
      "endMs": 253441,
      "durationMs": 16191
    }
  ]
}
