  "lines": [
    {
      "startMs": 11900,
      "text": "一切从这里开始揭开序幕",
      "endMs": 14870,
      "durationMs": 2970
    },
    {
      "startMs": 14870,
      "text": "我只是想要了解真相而已",
      "endMs": 17900,
      "durationMs": 3030
    },
    {
      "startMs": 17900,
      "text": "无论相隔多远都没有问题",
      "endMs": 20900,
      "durationMs": 3000
    },
    {
      "startMs": 20900,
      "text": "神秘之光始终照拂着大地",
      "endMs": 35770,
      "durationMs": 14870
    },
    {
      "startMs": 35770,
      "text": "足陷黄沙也无妨",
      "endMs": 38870,
      "durationMs": 3100
    },
    {
      "startMs": 38870,
      "text": "我仍会再次迈步",
      "endMs": 41910,
      "durationMs": 3040
    },
    {
      "startMs": 41910,
      "text": "崭新的风 那一日的记忆",
      "endMs": 44910,
      "durationMs": 3000
    },
    {
      "startMs": 44910,
      "text": "治愈我的心灵的绿洲",
      "endMs": 47800,
      "durationMs": 2890
    },
    {
      "startMs": 47800,
      "text": "那被隐藏至今的秘密",
      "endMs": 50690,
      "durationMs": 2890
    },
    {
      "startMs": 50690,
      "text": "就由我来一一寻获吧",
      "endMs": 53940,
      "durationMs": 3250
    },
    {
      "startMs": 53940,
      "text": "跟随太阳的指引 去往无人知晓的地方",
      "endMs": 68870,
      "durationMs": 14930
    },
    {
      "startMs": 68870,
      "text": "跟随那照耀着我的太阳",
      "endMs": 80840,
      "durationMs": 11970
    },
    {
      "startMs": 80840,
      "text": "神秘无论何时都与我同在",
      "endMs": 84010,
      "durationMs": 3170
    },
    {
      "startMs": 84010,
      "text": "绽放更璀璨的光芒",
      "endMs": 86910,
      "durationMs": 2900
    },
    {
      "startMs": 86910,
      "text": "每个人都心怀梦想",
      "endMs": 89880,
      "durationMs": 2970
    },
    {
      "startMs": 89880,
      "text": "在流淌的岁月长河中",
      "endMs": 92810,
      "durationMs": 2930
    },
    {
      "startMs": 92810,
      "text": "为了将自由纳入手中",
      "endMs": 95780,
      "durationMs": 2970
    },
    {
      "startMs": 95780,
      "text": "日复一日 还能去往更远的地方 探索更深处的秘密",
      "endMs": 99180,
      "durationMs": 3400
    },
    {
      "startMs": 99180,
      "text": "指引我去往那片未知的大地",
      "endMs": 102010,
      "durationMs": 2830
    },
    {
      "startMs": 102010,
      "text": "沐浴着炽热地盛燃着的太阳",
      "endMs": 103600,
      "durationMs": 1590
    },
    {
      "startMs": 103600,
      "text": "所追求的事物究竟是什么呢",
      "endMs": 105170,
      "durationMs": 1570
    },
    {
      "startMs": 105170,
      "text": "不愿看到更多枯朽覆灭的结局",
      "endMs": 107090,
      "durationMs": 1920
    },
    {
      "startMs": 107090,
      "text": "快停下",
      "endMs": 119900,
      "durationMs": 12810
    },
    {
      "startMs": 119900,
      "text": "收集这一路上我所亲历的奇迹",
      "endMs": 125790,
      "durationMs": 5890
    },
    {
      "startMs": 125790,
      "text": "始终抱有一颗期待跃动的心",
      "endMs": 128590,
      "durationMs": 2800
    },
    {
      "startMs": 128590,
      "text": "总有一天会找到我一直探寻的事物",
      "endMs": 131880,
      "durationMs": 3290
    },
    {
      "startMs": 131880,
      "text": "季节流转更替 过去也随之复苏",
      "endMs": 137980,
      "durationMs": 6100
    },
    {
      "startMs": 137980,
      "text": "崭新的风 那一日的记忆",
      "endMs": 140900,
      "durationMs": 2920
