{
  "schemaVersion": 1,
  "template": {
    "id": "study-current-v2",
    "sha256": "232cf0c76874b2c46f4abdf95d5e2ad936dbd87c7b3d56fcf1a16afcee9a558f"
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "normalized": {
      "width": 1,
      "height": 1
    }
  },
  "font": {
    "path": "C:/Windows/Fonts/msyhbd.ttc",
    "weight": 700
  },
  "colors": {
    "body": "#FFFFFF",
    "active": "#987EFF",
    "cardFill": "#605491BF",
    "cardOutline": "#987EFF"
  },
  "cover": {
    "rectPx": [
      850,
      35,
      220,
      220
    ]
  },
  "lyric": {
    "layout": "inline-source-order",
    "maxWidth": 0.9,
    "overflow": "shrink-then-wrap",
    "minimumFontScale": 0.76,
    "tokenAnchors": "shared-lyric-romaji-annotation",
    "furigana": {
      "kanjiOnly": true,
      "align": "left-to-kanji-run",
      "fontSize": 28,
      "topPx": 320
    },
    "loanwordAnnotation": {
      "source": "sourceWord",
      "align": "center-over-token",
      "fontSize": 23,
      "topPx": 320
    },
    "japanese": {
      "fontSize": 70,
      "fontWeight": 700,
      "baselinePx": 360
    },
    "english": {
      "fontSize": 42,
      "fontWeight": 700,
      "baselinePx": 382,
      "furigana": false,
      "romaji": false
    },
    "romaji": {
      "japaneseOnly": true,
      "fontSize": 34,
      "fontWeight": 700,
      "baselinePx": 485,
      "anchor": "center-under-token"
    },
    "translation": {
      "anchor": "center",
      "fontSize": 45,
      "fontWeight": 700,
      "topPx": 595,
      "maxLines": 2
    },
    "highlight": {
      "source": "qrc",
      "targets": [
        "japanese",
        "furigana",
        "romaji",
        "english"
      ],
      "cards": false,
      "contrast": "use a high-chroma light accent when palette.activeTint is too muted beneath the veil"
    }
  },
  "cards": {
    "rectPx": [
      90,
      705,
      1740,
      245
    ],
    "gapPx": 12,
    "radiusPx": 20,
    "fill": "palette.cardFill",
    "alpha": 0.75,
    "fields": [
      "token",
      "zhMeaning-or-functionZh",
      "posZh"
    ],
    "fieldLayout": {
      "token": {
        "topPx": 730,
        "fontSize": 37,
        "fontWeight": 700,
        "maxLines": 1
      },
      "meaning": {
        "topPx": 795,
        "fontSize": 26,
        "fontWeight": 700,
        "maxLines": 1,
        "fit": "shrink-to-single-line",
        "verticalAlign": "center"
      },
      "pos": {
        "topPx": 855,
        "fontSize": 25,
        "fontWeight": 700,
        "maxLines": 1
      },
      "horizontalAlign": "center",
      "verticalFlow": "independent-fields"
    },
    "cardFlow": "single-horizontal-row",
    "overflow": "shrink-fields-to-single-line-or-fail",
    "activeHighlight": false
  },
  "background": {
    "schemaVersion": 1,
    "id": "video-once-then-cover-gaussian",
    "owns": "background-only",
    "audio": "mute-source-video",
    "loop": "disabled",
    "fit": "height-center-pillarbox",
    "clock": "audio",
    "transition": {
      "type": "crossfade",
      "durationMs": 800,
      "startsAt": "video-end-minus-800ms",
      "foregroundContinuous": true
    },
    "segments": [
      {
        "mode": "video",
        "startMs": 0,
        "endMs": 91132,
        "audio": "mute",
        "fit": "height-center-pillarbox"
      },
      {
        "mode": "cover-gaussian",
        "startMs": 91132,
        "endMs": "audio-duration",
        "coverFit": "fill-crop-allowed-background-only",
        "blurRadius": 30,
        "darkOverlayOpacity": 0.41
      }
    ]
  }
}
