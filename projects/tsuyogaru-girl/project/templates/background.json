{
  "schemaVersion": 1,
  "id": "video-once-then-cover-gaussian",
  "owns": "background-only",
  "spectrumOverlay": {
    "preset": "foobar2000-classic-segmented-bars",
    "layer": "above-foreground",
    "alwaysAnimate": true,
    "style": "classic-segmented-bars-with-peak-hold",
    "placement": { "anchor": "bottom-edge", "widthPx": 1500, "heightPx": 58, "yPx": 1012 },
    "audioAnalysis": { "windowSamples": 2048, "overlap": 0.82, "amplitudeScale": "adaptive-log", "frequencyScale": "log", "frameRate": 30, "gain": 0.5, "normalizer": 3.0, "attack": 0.85, "release": 0.38, "peakDecay": 0.045 },
    "alpha": 0.88,
    "tint": "magic-activeTint",
    "background": "transparent"
  },
  "audio": "mute-source-video",
  "loop": "disabled",
  "fit": "height-center-pillarbox",
  "clock": "audio",
  "transition": { "type": "crossfade", "durationMs": 800, "startsMs": 90332, "foregroundContinuous": true },
  "segments": [
    { "mode": "video", "startMs": 0, "endMs": 91132, "audio": "mute", "fit": "height-center-pillarbox" },
    { "mode": "cover-gaussian", "startMs": 91132, "endMs": "audio-duration", "coverFit": "fill-crop-allowed-background-only", "blurRadius": 30, "darkOverlayOpacity": 0.41 }
  ]
}
