{
  "schemaVersion": 1,
  "format": "lrc-line-timed",
  "lines": [
    {
      "startMs": 6520,
      "text": "转过头不再去看水面泛起的波纹",
      "endMs": 12330,
      "durationMs": 5810
    },
    {
      "startMs": 12330,
      "text": "因为我想隐藏心中的那份动摇",
      "endMs": 18180,
      "durationMs": 5850
    },
    {
      "startMs": 18180,
      "text": "仅是因为与你并肩而立 我的心",
      "endMs": 24370,
      "durationMs": 6190
    },
    {
      "startMs": 24370,
      "text": "便燥热到难以平息",
      "endMs": 28770,
      "durationMs": 4400
    },
    {
      "startMs": 28770,
      "text": "微醺 轻叹 带着些许羞涩",
      "endMs": 31680,
      "durationMs": 2910
    },
    {
      "startMs": 31680,
      "text": "深陷柔软的梦境",
      "endMs": 34630,
      "durationMs": 2950
    },
    {
      "startMs": 34630,
      "text": "衣袖轻擦 心潮涨落 与你对上了视线",
      "endMs": 40460,
      "durationMs": 5830
    },
    {
      "startMs": 40460,
      "text": "你眼眸深处光芒璀璨",
      "endMs": 43370,
      "durationMs": 2910
    },
    {
      "startMs": 43370,
      "text": "似是要浅尝一口般 轻唤着你的名字",
      "endMs": 54730,
      "durationMs": 11360
    },
    {
      "startMs": 54730,
      "text": "而滑过喉头的那一抹滋味",
      "endMs": 60580,
      "durationMs": 5850
    },
    {
      "startMs": 60580,
      "text": "让初次体会的感情满溢",
      "endMs": 66460,
      "durationMs": 5880
    },
    {
      "startMs": 66460,
      "text": "憧憬与伤痕都在此时此刻",
      "endMs": 75260,
      "durationMs": 8800
    },
    {
      "startMs": 75260,
      "text": "交织相融 璀璨闪耀",
      "endMs": 85460,
      "durationMs": 10200
    },
    {
      "startMs": 85460,
      "text": "我透过玻璃杯看着",
      "endMs": 88390,
      "durationMs": 2930
    },
    {
      "startMs": 88390,
      "text": "对面那个",
      "endMs": 91300,
      "durationMs": 2910
    },
    {
      "startMs": 91300,
      "text": "视线追随着流云轨迹的你",
      "endMs": 97140,
      "durationMs": 5840
    },
    {
      "startMs": 97140,
      "text": "在微风轻拂的午后我竟觉得世界美到",
      "endMs": 103460,
      "durationMs": 6320
    },
    {
      "startMs": 103460,
      "text": "似是焕然一新般",
      "endMs": 107790,
      "durationMs": 4330
    },
    {
      "startMs": 107790,
      "text": "我们的身影依偎在一起 暗自怀揣期待",
      "endMs": 113640,
      "durationMs": 5850
    },
    {
      "startMs": 113640,
      "text": "又兀自抹去 等待许久后牵起你的手来",
      "endMs": 119490,
      "durationMs": 5850
    },
    {
      "startMs": 119490,
      "text": "微苦中泛着丝丝甜蜜",
      "endMs": 122410,
      "durationMs": 2920
    },
    {
      "startMs": 122410,
      "text": "几欲倾泻的思念满溢在我的心间",
      "endMs": 133750,
      "durationMs": 11340
    },
    {
      "startMs": 133750,
      "text": "你纯真无邪的双眸",
      "endMs": 139630,
      "durationMs": 5880
    },
    {
      "startMs": 139630,
      "text": "带着热意闪过些许的困惑",
      "endMs": 145490,
      "durationMs": 5860
    },
    {
      "startMs": 145490,
      "text": "迄今为止的我们仿佛已准备好",
      "endMs": 154260,
      "durationMs": 8770
    },
    {
      "startMs": 154260,
      "text": "将过往统统都飞跃",
      "endMs": 164750,
      "durationMs": 10490
    },
    {
      "startMs": 164750,
      "text": "真实心声仍不够确切也无妨",
      "endMs": 171030,
      "durationMs": 6280
    },
    {
      "startMs": 171030,
      "text": "心有所想 尚且不算遥远",
      "endMs": 175440,
      "durationMs": 4410
    },
    {
      "startMs": 175440,
      "text": "不过我希望 只有我 能知晓你落泪的理由",
      "endMs": 195140,
      "durationMs": 19700
    },
    {
      "startMs": 195140,
      "text": "而滑过喉头的那一抹滋味",
      "endMs": 201070,
      "durationMs": 5930
    },
    {
      "startMs": 201070,
      "text": "让初次体会的感情满溢",
      "endMs": 206910,
      "durationMs": 5840
    },
    {
      "startMs": 206910,
      "text": "憧憬与伤痕都在此时此刻",
      "endMs": 215710,
      "durationMs": 8800
    },
    {
      "startMs": 215710,
      "text": "交织相融 璀璨闪耀",
      "endMs": 240276,
      "durationMs": 24566
    }
  ]
}
