  "lines": [
    {
      "startMs": 7990,
      "text": "尽管一直以来我都在竭力地逞强",
      "endMs": 14380,
      "durationMs": 6390
    },
    {
      "startMs": 14380,
      "text": "可在你面前却还是不得要领",
      "endMs": 20800,
      "durationMs": 6420
    },
    {
      "startMs": 20800,
      "text": "甚至比碳酸气泡消散的速度还要快",
      "endMs": 26420,
      "durationMs": 5620
    },
    {
      "startMs": 26420,
      "text": "我依然不曾察觉到",
      "endMs": 28990,
      "durationMs": 2570
    },
    {
      "startMs": 28990,
      "text": "这份正悄然发生改变的心情",
      "endMs": 36020,
      "durationMs": 7030
    },
    {
      "startMs": 36020,
      "text": "呐 尽管与最初向往的未来",
      "endMs": 45990,
      "durationMs": 9970
    },
    {
      "startMs": 45990,
      "text": "稍微有一些不同",
      "endMs": 49600,
      "durationMs": 3610
    },
    {
      "startMs": 49600,
      "text": "但最后我已经别无他求",
      "endMs": 57220,
      "durationMs": 7620
    },
    {
      "startMs": 57220,
      "text": "只愿身边能有你",
      "endMs": 62400,
      "durationMs": 5180
    },
    {
      "startMs": 62400,
      "text": "有你相伴的明天实在是美好",
      "endMs": 65380,
      "durationMs": 2980
    },
    {
      "startMs": 65380,
      "text": "空有这种念头也改变不了什么",
      "endMs": 68740,
      "durationMs": 3360
    },
    {
      "startMs": 68740,
      "text": "必须传达给你",
      "endMs": 75160,
      "durationMs": 6420
    },
    {
      "startMs": 75160,
      "text": "总将视线投向做不到的事情",
      "endMs": 81230,
      "durationMs": 6070
    },
    {
      "startMs": 81230,
      "text": "其实我很想告诉那样的你",
      "endMs": 88030,
      "durationMs": 6800
    },
    {
      "startMs": 88030,
      "text": "我真正想要了解的就是真实的你",
      "endMs": 93600,
      "durationMs": 5570
    },
    {
      "startMs": 93600,
      "text": "我早已",
      "endMs": 95420,
      "durationMs": 1820
    },
    {
      "startMs": 95420,
      "text": "不再执着于正确答案了",
      "endMs": 100370,
      "durationMs": 4950
    },
    {
      "startMs": 100370,
      "text": "你还没意识到这点吧",
      "endMs": 117030,
      "durationMs": 16660
    },
    {
      "startMs": 117030,
      "text": "别再为季节的更迭",
      "endMs": 120030,
      "durationMs": 3000
    },
    {
      "startMs": 120030,
      "text": "而感到犹豫彷徨了",
      "endMs": 123370,
      "durationMs": 3340
    },
    {
      "startMs": 123370,
      "text": "迄今为止的一切",
      "endMs": 126150,
      "durationMs": 2780
    },
    {
      "startMs": 126150,
      "text": "会在未来的某天相连",
      "endMs": 135980,
      "durationMs": 9830
    },
    {
      "startMs": 135980,
      "text": "尽管与最初向往的未来",
      "endMs": 145190,
      "durationMs": 9210
    },
    {
      "startMs": 145190,
      "text": "稍微有一些不同",
      "endMs": 148800,
      "durationMs": 3610
    },
    {
      "startMs": 148800,
      "text": "但最后我已经别无他求",
      "endMs": 156400,
      "durationMs": 7600
    },
    {
      "startMs": 156400,
      "text": "只愿身边能有你",
      "endMs": 161590,
      "durationMs": 5190
    },
    {
      "startMs": 161590,
      "text": "因为笨拙而错失彼此",
      "endMs": 164400,
      "durationMs": 2810
    },
    {
      "startMs": 164400,
      "text": "然后开始胡乱猜忌的我们",
      "endMs": 167970,
      "durationMs": 3570
    },
    {
      "startMs": 167970,
      "text": "总想着说不出口说不出口",
      "endMs": 170380,
      "durationMs": 2410
    },
    {
      "startMs": 170380,
      "text": "确实相当专断吧",
      "endMs": 174400,
      "durationMs": 4020
    },
    {
      "startMs": 174400,
      "text": "有你相伴的明天实在是美好",
      "endMs": 177410,
      "durationMs": 3010
    },
    {
      "startMs": 177410,
      "text": "空有这种念头也改变不了什么",
      "endMs": 180820,
      "durationMs": 3410
    },
    {
      "startMs": 180820,
      "text": "必须传达给你",
      "endMs": 187160,
      "durationMs": 6340
    },
    {
      "startMs": 187160,
      "text": "在最初 到最后",
      "endMs": 219294,
      "durationMs": 32134
    }
  ]
