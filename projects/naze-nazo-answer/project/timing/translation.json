    {
      "startMs": 790,
      "text": "(为为为为 为何?为何?为何?)",
      "endMs": 3850,
      "durationMs": 3060
    },
    {
      "startMs": 3850,
      "text": "(谜谜谜谜 谜题?提示 得出答案?)",
      "endMs": 12010,
      "durationMs": 8160
    },
    {
      "startMs": 12010,
      "text": "串联散落的线索后 奇怪?奇怪",
      "endMs": 14830,
      "durationMs": 2820
    },
    {
      "startMs": 14830,
      "text": "“便能完美解决” 能吧?能吧?",
      "endMs": 17750,
      "durationMs": 2920
    },
    {
      "startMs": 17750,
      "text": "推理与谜团互为表里 再三反转 彻底逆转",
      "endMs": 23560,
      "durationMs": 5810
    },
    {
      "startMs": 23560,
      "text": "就连言辞与举止 都是圈套?陷阱",
      "endMs": 26450,
      "durationMs": 2890
    },
    {
      "startMs": 26450,
      "text": "轻易地盲从相信 可不行 绝对不行",
      "endMs": 29360,
      "durationMs": 2910
    },
    {
      "startMs": 29360,
      "text": "必须要经过仔细观察 认真思考后",
      "endMs": 32290,
      "durationMs": 2930
    },
    {
      "startMs": 32290,
      "text": "才可以迈出那一步",
      "endMs": 35180,
      "durationMs": 2890
    },
    {
      "startMs": 35180,
      "text": "若是看到有人陷入困境",
      "endMs": 38590,
      "durationMs": 3410
    },
    {
      "startMs": 38590,
      "text": "就想立马伸出援手",
      "endMs": 40890,
      "durationMs": 2300
    },
    {
      "startMs": 40890,
      "text": "毕竟 不论如何 不论如何",
      "endMs": 42890,
      "durationMs": 2000
    },
    {
      "startMs": 42890,
      "text": "都想要做些什么 为此飞奔而去",
      "endMs": 45940,
      "durationMs": 3050
    },
    {
      "startMs": 45940,
      "text": "谜 谜 谜 谜题 谜题",
      "endMs": 47770,
      "durationMs": 1830
    },
    {
      "startMs": 47770,
      "text": "解开谜题的就是名侦探☆",
      "endMs": 52270,
      "durationMs": 4500
    },
    {
      "startMs": 52270,
      "text": "明辨真假虚实 最终只是为了",
      "endMs": 55360,
      "durationMs": 3090
    },
    {
      "startMs": 55360,
      "text": "寻获那抹笑容的答案",
      "endMs": 57520,
      "durationMs": 2160
    },
    {
      "startMs": 57520,
      "text": "为 为 为 为何?为何?",
      "endMs": 59320,
      "durationMs": 1800
    },
    {
      "startMs": 59320,
      "text": "有大家相伴勇气便100倍飙升",
      "endMs": 63860,
      "durationMs": 4540
    },
    {
      "startMs": 63860,
      "text": "齐心协力就能跨越所有的困难",
      "endMs": 66940,
      "durationMs": 3080
    },
    {
      "startMs": 66940,
      "text": "朋友便是奇迹的结晶",
      "endMs": 69130,
      "durationMs": 2190
    },
    {
      "startMs": 69130,
      "text": "上吧 名侦探☆",
      "endMs": 75620,
      "durationMs": 6490
    },
    {
      "startMs": 75620,
      "text": "将点与线串联起来后 你看 你看?",
      "endMs": 78370,
      "durationMs": 2750
    },
    {
      "startMs": 78370,
      "text": "“便能完美解决” 可能?可能?",
      "endMs": 81310,
      "durationMs": 2940
    },
    {
      "startMs": 81310,
      "text": "箭头早就指向了答案",
      "endMs": 84270,
      "durationMs": 2960
    },
    {
      "startMs": 84270,
      "text": "痛快 愉快 爽快",
      "endMs": 87230,
      "durationMs": 2960
    },
    {
      "startMs": 87230,
      "text": "但是啊 可是啊 谜题仍无法解开",
      "endMs": 90060,
      "durationMs": 2830
    },
    {
      "startMs": 90060,
      "text": "那是心灵的迷宫",
      "endMs": 92980,
      "durationMs": 2920
    },
    {
      "startMs": 92980,
      "text": "秘密的钥匙无法强行撬开",
      "endMs": 95850,
      "durationMs": 2870
    },
    {
      "startMs": 95850,
      "text": "只能依靠相依相伴 实在抱歉",
      "endMs": 98780,
      "durationMs": 2930
    },
    {
      "startMs": 98780,
      "text": "在有人受伤的时候",
      "endMs": 102180,
      "durationMs": 3400
    },
    {
      "startMs": 102180,
      "text": "其实根本无需多言",
      "endMs": 104530,
      "durationMs": 2350
    },
    {
      "startMs": 104530,
      "text": "我愿一直陪在你身边",
      "endMs": 106510,
      "durationMs": 1980
    },
    {
      "startMs": 106510,
      "text": "成为你在世上最坚定的伙伴",
      "endMs": 109590,
      "durationMs": 3080
    },
    {
      "startMs": 109590,
      "text": "谜 谜 谜 谜题 谜题",
      "endMs": 111400,
      "durationMs": 1810
    },
    {
      "startMs": 111400,
      "text": "解开谜题的就是名侦探☆",
      "endMs": 115930,
      "durationMs": 4530
    },
    {
      "startMs": 115930,
      "text": "越是竭力追逐越会逃离而去",
      "endMs": 118920,
      "durationMs": 2990
    },
    {
      "startMs": 118920,
      "text": "还真是一桩充满了矛盾的谜案",
      "endMs": 121160,
      "durationMs": 2240
    },
    {
      "startMs": 121160,
      "text": "为 为 为 为何?为何?",
      "endMs": 122940,
      "durationMs": 1780
    },
    {
      "startMs": 122940,
      "text": "有大家相伴活力便100倍飙升",
      "endMs": 127480,
      "durationMs": 4540
    },
    {
      "startMs": 127480,
      "text": "可不能让失误就这样成为失误",
      "endMs": 130560,
      "durationMs": 3080
    },
    {
      "startMs": 130560,
      "text": "与伙伴一同回收伏笔",
      "endMs": 132690,
      "durationMs": 2130
    },
    {
      "startMs": 132690,
      "text": "出发吧 名侦探☆",
      "endMs": 161970,
      "durationMs": 29280
    },
    {
      "startMs": 161970,
      "text": "虽然所谓的正确也都因人而异",
      "endMs": 166330,
      "durationMs": 4360
    },
    {
      "startMs": 166330,
      "text": "但若是温柔都否引发共鸣?",
      "endMs": 169220,
      "durationMs": 2890
    },
    {
      "startMs": 169220,
      "text": "我希望能将这份温暖与心动",
      "endMs": 171350,
      "durationMs": 2130
    },
    {
      "startMs": 171350,
      "text": "传达出去",
      "endMs": 173590,
      "durationMs": 2240
    },
    {
      "startMs": 173590,
      "text": "在鼓起勇气后希望便会映入眼帘",
      "endMs": 176800,
      "durationMs": 3210
    },
    {
      "startMs": 176800,
      "text": "莎啦啦啦",
      "endMs": 177900,
      "durationMs": 1100
    },
    {
