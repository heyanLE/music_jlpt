{
  "schemaVersion": 1,
  "format": "lrc-line-timed",
  "lines": [
    {
      "startMs": 13180,
      "text": "不会沾染他人的色彩 更不会成为任何人",
      "endMs": 16440,
      "durationMs": 3260
    },
    {
      "startMs": 16440,
      "text": "就让我当这是一场梦一笑置之",
      "endMs": 19820,
      "durationMs": 3380
    },
    {
      "startMs": 19820,
      "text": "忘却那份软弱 却变得愈发不堪一击",
      "endMs": 22950,
      "durationMs": 3130
    },
    {
      "startMs": 22950,
      "text": "怎么可能因此将寂寞之类的心绪宣之于口",
      "endMs": 25670,
      "durationMs": 2720
    },
    {
      "startMs": 25670,
      "text": "就连平淡无奇的对话也能刺伤心扉",
      "endMs": 32170,
      "durationMs": 6500
    },
    {
      "startMs": 32170,
      "text": "任何人 不论是谁都无法让我幸福",
      "endMs": 38710,
      "durationMs": 6540
    },
    {
      "startMs": 38710,
      "text": "呐 即便如此心中的期待仍旧在兀自膨胀",
      "endMs": 44790,
      "durationMs": 6080
    },
    {
      "startMs": 44790,
      "text": "将那些让彼此错失真心的谎言尽数舍弃",
      "endMs": 50790,
      "durationMs": 6000
    },
    {
      "startMs": 50790,
      "text": "想要听到的",
      "endMs": 51440,
      "durationMs": 650
    },
    {
      "startMs": 51440,
      "text": "唯有那句“这并非是大言不惭”",
      "endMs": 54040,
      "durationMs": 2600
    },
    {
      "startMs": 54040,
      "text": "哪怕一心逐梦的我尽显幼稚",
      "endMs": 57390,
      "durationMs": 3350
    },
    {
      "startMs": 57390,
      "text": "哪怕时至今日依旧无从改变",
      "endMs": 59230,
      "durationMs": 1840
    },
    {
      "startMs": 59230,
      "text": "也无妨",
      "endMs": 60990,
      "durationMs": 1760
    },
    {
      "startMs": 60990,
      "text": "只要能与你一同歌唱就好",
      "endMs": 63400,
      "durationMs": 2410
    },
    {
      "startMs": 63400,
      "text": "不论多少次",
      "endMs": 64210,
      "durationMs": 810
    },
    {
      "startMs": 64210,
      "text": "唯有感情在心中摇摆不定",
      "endMs": 66770,
      "durationMs": 2560
    },
    {
      "startMs": 66770,
      "text": "虽然遭到了厌恶",
      "endMs": 70010,
      "durationMs": 3240
    },
    {
      "startMs": 70010,
      "text": "我仍会就这样继续迈步而行",
      "endMs": 73280,
      "durationMs": 3270
    },
    {
      "startMs": 73280,
      "text": "我会为独一无二的自己感到骄傲",
      "endMs": 89790,
      "durationMs": 16510
    },
    {
      "startMs": 89790,
      "text": "与不再需要的多余之物尽数告别",
      "endMs": 93170,
      "durationMs": 3380
    },
    {
      "startMs": 93170,
      "text": "抹消这一切便能获得自由吗？",
      "endMs": 96430,
      "durationMs": 3260
    },
    {
      "startMs": 96430,
      "text": "将喧嚣脑海中某人所说的话",
      "endMs": 99600,
      "durationMs": 3170
    },
    {
      "startMs": 99600,
      "text": "尽数舍弃我就能活出自己了吧",
      "endMs": 102600,
      "durationMs": 3000
    },
    {
      "startMs": 102600,
      "text": "铭记于心的唯有驻足不前这种事",
      "endMs": 109090,
      "durationMs": 6490
    },
    {
      "startMs": 109090,
      "text": "并非那样也并非这样",
      "endMs": 112170,
      "durationMs": 3080
    },
    {
      "startMs": 112170,
      "text": "一切都已扭曲不堪",
      "endMs": 115350,
      "durationMs": 3180
    },
    {
      "startMs": 115350,
      "text": "充斥着悔恨的夜晚难以迎来黎明",
      "endMs": 121630,
      "durationMs": 6280
    },
    {
      "startMs": 121630,
      "text": "期待晨曦倾洒时身边有人相伴",
      "endMs": 140230,
      "durationMs": 18600
    },
    {
      "startMs": 140230,
      "text": "所谓的代价",
      "endMs": 140990,
      "durationMs": 760
    },
    {
      "startMs": 140990,
      "text": "再过困难我也会努力将其超越",
      "endMs": 143590,
      "durationMs": 2600
    },
    {
      "startMs": 143590,
      "text": "明明已下定决心却想推翻重来",
      "endMs": 146760,
      "durationMs": 3170
    },
    {
      "startMs": 146760,
      "text": "一味地沉溺于想象根本就难以满足",
      "endMs": 150390,
      "durationMs": 3630
    },
    {
      "startMs": 150390,
      "text": "想试着与你实现梦想",
      "endMs": 153040,
      "durationMs": 2650
    },
    {
      "startMs": 153040,
      "text": "究竟是为何",
      "endMs": 153800,
      "durationMs": 760
    },
    {
      "startMs": 153800,
      "text": "那份伤感的情绪",
      "endMs": 156370,
      "durationMs": 2570
    },
    {
      "startMs": 156370,
      "text": "总会让人筑起一面心墙呢",
      "endMs": 159630,
      "durationMs": 3260
    },
    {
      "startMs": 159630,
      "text": "如果能够成为某人的希望",
      "endMs": 162850,
      "durationMs": 3220
    },
    {
      "startMs": 162850,
      "text": "就能心怀那份难以对他人言说的痛楚",
      "endMs": 169610,
      "durationMs": 6760
    },
    {
      "startMs": 169610,
      "text": "哪怕孤身一人",
      "endMs": 172390,
      "durationMs": 2780
    },
    {
      "startMs": 172390,
      "text": "仍坚信这个毫无疑问的自己",
      "endMs": 175630,
      "durationMs": 3240
    },
    {
      "startMs": 175630,
      "text": "每当受伤倒下的时候都只需尽情歌唱",
      "endMs": 191147,
      "durationMs": 15517
    }
  ]
}
