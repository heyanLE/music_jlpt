{
  "schemaVersion": 3,
  "id": "study-current-v3",
  "owns": "foreground-only",
  "canvas": { "referenceWidth": 1920, "referenceHeight": 1080, "fps": 30 },
  "font": { "role": "cjk-bold", "minimumWeight": 700, "fallback": ["Microsoft YaHei Bold", "Noto Sans CJK Bold"] },
  "colors": { "body": "palette.body", "active": "palette.activeTint or contrast-boosted-accent", "cardFill": "palette.cardFill", "cardOutline": "palette.activeTint", "cardFillAlpha": { "min": 0.70, "max": 0.80 } },
  "strokePx": { "japanese": 4, "english": 4, "furigana": 2, "loanwordAnnotation": 2, "romaji": 2, "translation": 3, "cardFields": 2 },
  "veil": { "color": "#000000", "opacity": 0.28, "zIndex": "below-foreground" },
  "variantId": "study-current-v3-static-neighbors-a",
  "cover": { "required": true, "anchor": "top-center", "rectPx": [850, 35, 220, 220], "fit": "cover" },
  "staticLyricNeighbors": { "enabled": true, "viewportPx": [0, 275, 1920, 480], "clipAtCanvasEdge": true, "sentenceGapPx": 56, "sentenceSidePaddingPx": 80, "transition": "original-hard-line-switch", "neighbors": ["previous", "current", "next"], "motion": "none", "neighborAlpha": 0.57, "furiganaHighlight": "whole-associated-block", "romajiHighlight": "whole-associated-block", "translation": "current-line-only", "cards": "current-line-only" },
  "lyric": {
    "layout": "inline-source-order", "maxWidth": 0.90, "overflow": "shrink-then-wrap", "minimumFontScale": 0.76, "tokenAnchors": "shared-lyric-romaji-annotation",
    "annotation": { "kanjiOnly": true, "furiganaAlign": "left-to-kanji-run", "loanwordSource": "sourceWord", "loanwordAlign": "center-over-token", "topPx": 295, "fontSize": 28, "loanwordFontSize": 23 },
    "japanese": { "topPx": 330, "fontSize": 70, "fontWeight": 700 },
    "english": { "topPx": 352, "fontSize": 70, "fontWeight": 700, "furigana": false, "romaji": false, "cards": false },
    "romaji": { "japaneseOnly": true, "topPx": 430, "fontSize": 34, "fontWeight": 700, "anchor": "center-under-token" },
    "translation": { "optional": true, "defaultEnabled": true, "anchor": "center", "topPx": 500, "fontSize": 45, "fontWeight": 700, "maxLines": 2, "overflow": "wrap-then-shrink-or-fail" },
    "highlight": { "targets": ["japanese", "furigana", "loanwordAnnotation", "romaji", "english"], "cards": false }
  },
  "cards": {
    "rectPx": [95, 600, 1730, 250], "gapPx": 12, "radiusPx": 20, "cardFlow": "single-horizontal-row", "fields": ["token", "zhMeaning-or-functionZh", "grammarStructureZh"], "legacyGrammarFallback": "posZh",
    "fieldLayout": {
      "token": { "topPx": 625, "fontSize": 37, "fontWeight": 700, "maxLines": 1, "overflow": "shrink-or-fail" },
      "meaning": { "oneLineTopPx": 695, "twoLineTopPx": 678, "lineHeightPx": 32, "fontSize": 26, "fontWeight": 700, "maxLines": 2, "overflow": "wrap-at-fixed-size-or-fail" },
      "grammarStructure": { "topPx": 770, "fontSize": 25, "fontWeight": 700, "maxLines": 1, "overflow": "shrink-or-fail" },
      "horizontalAlign": "center", "verticalFlow": "independent-fields"
    },
    "activeHighlight": false
  },
  "forbidden": ["playback-controls", "opaque-neutral-black-cards", "unanchored-romaji", "missing-cover", "serialized-card-fields"]
}
