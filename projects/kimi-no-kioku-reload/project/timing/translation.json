{
  "schemaVersion": 1,
  "format": "lrc-line-timed",
  "lines": [
    {
      "startMs": 17500,
      "text": "微风窸窣 光之微粒",
      "endMs": 21560,
      "durationMs": 4060
    },
    {
      "startMs": 21560,
      "text": "倾洒在沉沉入眠的你身上",
      "endMs": 25550,
      "durationMs": 3990
    },
    {
      "startMs": 25550,
      "text": "难以忘却那抹温柔的微笑",
      "endMs": 30140,
      "durationMs": 4590
    },
    {
      "startMs": 30140,
      "text": "还有隐藏哀伤的眼眸",
      "endMs": 34600,
      "durationMs": 4460
    },
    {
      "startMs": 34600,
      "text": "哪怕心怀所愿令人痛苦",
      "endMs": 39210,
      "durationMs": 4610
    },
    {
      "startMs": 39210,
      "text": "我也从你那里获得了直面一切的勇气",
      "endMs": 41630,
      "durationMs": 2420
    },
    {
      "startMs": 41630,
      "text": "所以我要出发了",
      "endMs": 43270,
      "durationMs": 1640
    },
    {
      "startMs": 43270,
      "text": "一旦从梦中醒来之后 便会再次相遇吧",
      "endMs": 51330,
      "durationMs": 8060
    },
    {
      "startMs": 51330,
      "text": "将遥远记忆深藏于心 放声歌唱",
      "endMs": 69420,
      "durationMs": 18090
    },
    {
      "startMs": 69420,
      "text": "只因虚幻摇曳的世界",
      "endMs": 71070,
      "durationMs": 1650
    },
    {
      "startMs": 71070,
      "text": "是由你亲自守护的",
      "endMs": 73700,
      "durationMs": 2630
    },
    {
      "startMs": 73700,
      "text": "此刻只需收起羽翼",
      "endMs": 76120,
      "durationMs": 2420
    },
    {
      "startMs": 76120,
      "text": "好好地睡一觉吧",
      "endMs": 78010,
      "durationMs": 1890
    },
    {
      "startMs": 78010,
      "text": "愿永恒的宁静萦绕着你",
      "endMs": 86580,
      "durationMs": 8570
    },
    {
      "startMs": 86580,
      "text": "我的臂弯会温柔守候你",
      "endMs": 88190,
      "durationMs": 1610
    },
    {
      "startMs": 88190,
      "text": "愿你可以好好地安眠",
      "endMs": 90860,
      "durationMs": 2670
    },
    {
      "startMs": 90860,
      "text": "曾经欢笑过 哭泣过 生气过",
      "endMs": 93280,
      "durationMs": 2420
    },
    {
      "startMs": 93280,
      "text": "你的一切我都记得",
      "endMs": 95120,
      "durationMs": 1840
    },
    {
      "startMs": 95120,
      "text": "永远都不会忘记",
      "endMs": 98910,
      "durationMs": 3790
    },
    {
      "startMs": 98910,
      "text": "直至耗尽我的余生都绝不忘记",
      "endMs": 137360,
      "durationMs": 38450
    },
    {
      "startMs": 137360,
      "text": "在十字路口传入我耳畔的",
      "endMs": 141500,
      "durationMs": 4140
    },
    {
      "startMs": 141500,
      "text": "是与你无比相似的声音",
      "endMs": 145530,
      "durationMs": 4030
    },
    {
      "startMs": 145530,
      "text": "回首望去 之后便抬头仰望天空",
      "endMs": 150110,
      "durationMs": 4580
    },
    {
      "startMs": 150110,
      "text": "竭力忍耐即将夺眶的泪水",
      "endMs": 154620,
      "durationMs": 4510
    },
    {
      "startMs": 154620,
      "text": "待到明天 或是未来某天",
      "endMs": 159160,
      "durationMs": 4540
    },
    {
      "startMs": 159160,
      "text": "我坚信自己还可以再见到你",
      "endMs": 161500,
      "durationMs": 2340
    },
    {
      "startMs": 161500,
      "text": "孤身一人深陷迷茫",
      "endMs": 163230,
      "durationMs": 1730
    },
    {
      "startMs": 163230,
      "text": "落雨的夜晚 晴朗的清晨 我都在不断等待",
      "endMs": 171210,
      "durationMs": 7980
    },
    {
      "startMs": 171210,
      "text": "绝不会忘记 在奔跑的那个夜晚",
      "endMs": 189440,
      "durationMs": 18230
    },
    {
      "startMs": 189440,
      "text": "璀璨闪耀的瞬间",
      "endMs": 191900,
      "durationMs": 2460
    },
    {
      "startMs": 191900,
      "text": "曾与大家一同度过",
      "endMs": 193770,
      "durationMs": 1870
    },
    {
      "startMs": 193770,
      "text": "可是在不知不觉间我便独自度过了",
      "endMs": 196140,
      "durationMs": 2370
    },
    {
      "startMs": 196140,
      "text": "那个根本无法替代的时刻",
      "endMs": 198060,
      "durationMs": 1920
    },
    {
      "startMs": 198060,
      "text": "此刻也只能怀缅往昔的美好",
      "endMs": 206640,
      "durationMs": 8580
    },
    {
      "startMs": 206640,
      "text": "你啊 曾经确确实实地",
      "endMs": 209010,
      "durationMs": 2370
    },
    {
      "startMs": 209010,
      "text": "陪伴在我的身旁",
      "endMs": 210880,
      "durationMs": 1870
    },
    {
      "startMs": 210880,
      "text": "不论何时我都可以立马看到",
      "endMs": 213320,
      "durationMs": 2440
    },
    {
      "startMs": 213320,
      "text": "你在身旁欢笑的模样",
      "endMs": 215090,
      "durationMs": 1770
    },
    {
      "startMs": 215090,
      "text": "哪怕历经失去也想重新拥有你",
      "endMs": 218090,
      "durationMs": 3000
    },
    {
      "startMs": 218090,
      "text": "我永远不会离你而去",
      "endMs": 258020,
      "durationMs": 39930
    },
    {
      "startMs": 258020,
      "text": "只因虚幻摇曳的世界",
      "endMs": 259670,
      "durationMs": 1650
