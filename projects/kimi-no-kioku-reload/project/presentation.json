{
  "schemaVersion": 2,
  "foreground": {
    "templateId": "study-current-v3",
    "variantId": "study-current-v3-static-neighbors-a",
    "staticLyricNeighbors": {
      "enabled": true,
      "template": "project/templates/foreground.json",
      "clipAtCanvasEdge": true,
      "transition": "original-hard-line-switch",
      "selection": "previous-current-next-chronological-frames"
    },
    "defaultMode": "follow-lyrics",
    "displayTiming": {
      "preRollMs": 0,
      "tailProtectionMs": 500,
      "internalGap": "hold-current-line"
    },
    "lineTranslation": {
      "enabled": true
    },
    "veil": {
      "color": "#000000",
      "opacity": 0.28
    },
    "highlight": {
      "mode": "token"
    },
    "textOutline": {
      "enabled": true,
      "color": "#000000"
    }
  },
  "floatingOverlay": {
    "id": "spectrum-foobar-bars",
    "enabled": true,
    "persistent": true,
    "zIndex": "above-foreground",
    "clock": "output"
  }
}
