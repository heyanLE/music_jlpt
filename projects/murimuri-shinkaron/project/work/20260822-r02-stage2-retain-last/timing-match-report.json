      "frameId": "l068",
      "mode": "full",
      "qrcStartMs": 130243,
      "qrcText": "わたしの進化論"
    },
    {
      "frameId": "l069",
      "mode": "full",
      "qrcStartMs": 133023,
      "qrcText": "ぜんぶ取っちゃいたい このタグも"
    },
    {
      "frameId": "l070",
      "mode": "full",
      "qrcStartMs": 136348,
      "qrcText": "この決まっちゃいそうな"
    },
    {
      "frameId": "l071",
      "mode": "full",
      "qrcStartMs": 137954,
      "qrcText": "レール上も"
    },
    {
      "frameId": "l072",
      "mode": "full",
      "qrcStartMs": 139313,
