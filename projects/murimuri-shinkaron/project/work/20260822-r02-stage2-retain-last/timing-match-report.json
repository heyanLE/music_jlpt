      "qrcText": "(ムリムリ)"
    },
    {
      "frameId": "l002",
      "mode": "full",
      "qrcStartMs": 1843,
      "qrcText": "ひとよひとよに人見知り"
    },
    {
      "frameId": "l003",
      "mode": "full",
      "qrcStartMs": 3798,
      "qrcText": "(ムリムリ)"
    },
    {
      "frameId": "l004",
      "mode": "full",
      "qrcStartMs": 4406,
      "qrcText": "ふたり以上での立ち回り？"
    },
    {
      "frameId": "l005",
      "mode": "full",
      "qrcStartMs": 6406,
      "qrcText": "(ムリムリ)"
    },
    {
      "frameId": "l006",
      "mode": "full",
      "qrcStartMs": 7126,
      "qrcText": "みつめられても"
    },
    {
      "frameId": "l007",
      "mode": "full",
      "qrcStartMs": 8118,
      "qrcText": "なんにも出ないですよ？"
    },
    {
      "frameId": "l008",
      "mode": "full",
      "qrcStartMs": 9117,
      "qrcText": "(ムリムリ)"
    },
    {
      "frameId": "l009",
      "mode": "full",
      "qrcStartMs": 9781,
      "qrcText": "ようこそ「ここ」へ"
    },
    {
      "frameId": "l010",
      "mode": "full",
      "qrcStartMs": 10678,
      "qrcText": "ウェルカムトゥ陰サイ"
    },
    {
      "frameId": "l011",
      "mode": "full",
      "qrcStartMs": 22119,
      "qrcText": "ア ア ア アノォ"
    },
    {
      "frameId": "l012",
      "mode": "full",
      "qrcStartMs": 23169,
      "qrcText": "最近このへんで「光」って見ました？"
    },
    {
      "frameId": "l013",
      "mode": "full",
      "qrcStartMs": 25001,
      "qrcText": "エエト それ目指して"
    },
    {
      "frameId": "l014",
      "mode": "full",
      "qrcStartMs": 26128,
      "qrcText": "歩き出してきたんです確か"
    },
    {
      "frameId": "l015",
      "mode": "full",
      "qrcStartMs": 27736,
      "qrcText": "そう 超絶進化の充実生活"
    },
    {
      "frameId": "l016",
      "mode": "full",
      "qrcStartMs": 29425,
      "qrcText": "この手につかむ"
    },
    {
      "frameId": "l017",
      "mode": "full",
      "qrcStartMs": 30490,
      "qrcText": "とかいって いま急にはじまったら？"
    },
    {
      "frameId": "l018",
      "mode": "full",
      "qrcStartMs": 32155,
      "qrcText": "(アァワワワワワワワァ)"
    },
    {
      "frameId": "l019",
      "mode": "full",
      "qrcStartMs": 33621,
      "qrcText": "万年補欠の完成形 てか"
    },
    {
      "frameId": "l020",
      "mode": "full",
      "qrcStartMs": 35973,
      "qrcText": "毎分毎秒マイマインドに反省点"
    },
    {
      "frameId": "l021",
      "mode": "full",
      "qrcStartMs": 38465,
      "qrcText": "ぎこちない体作るキャラが"
    },
    {
      "frameId": "l022",
      "mode": "full",
      "qrcStartMs": 40002,
      "qrcText": "ミスマッチだからだ"
    },
    {
      "frameId": "l023",
      "mode": "full",
      "qrcStartMs": 41369,
      "qrcText": "でもキミの前では"
    },
    {
      "frameId": "l024",
      "mode": "full",
      "qrcStartMs": 42587,
      "qrcText": "なんかナチュラル"
    },
    {
      "frameId": "l025",
      "mode": "full",
      "qrcStartMs": 43756,
      "qrcText": "チョ ちょっとまってそのワード"
    },
    {
      "frameId": "l026",
      "mode": "full",
      "qrcStartMs": 46115,
      "qrcText": "同じセカイに行きたいんだキミと"
    },
    {
      "frameId": "l027",
      "mode": "full",
      "qrcStartMs": 49260,
      "qrcText": "陰サイ陽サイ巻き込んだ"
    },
    {
      "frameId": "l028",
      "mode": "full",
      "qrcStartMs": 50580,
      "qrcText": "運命の大革命"
    },
    {
      "frameId": "l029",
      "mode": "full",
      "qrcStartMs": 53522,
      "qrcText": "こんなわたしじゃ"
    },
    {
      "frameId": "l030",
      "mode": "full",
      "qrcStartMs": 54582,
      "qrcText": "ムリムリ ムリムリ なんて"
    },
    {
      "frameId": "l031",
      "mode": "full",
      "qrcStartMs": 57097,
      "qrcText": "逃げるには長すぎるワンデイ"
    },
    {
      "frameId": "l032",
      "mode": "full",
      "qrcStartMs": 60013,
      "qrcText": "陰むしたキモチが"
    },
    {
      "frameId": "l033",
      "mode": "full",
      "qrcStartMs": 61341,
      "qrcText": "太陽へ伸びちゃって"
    },
    {
      "frameId": "l034",
      "mode": "full",
      "qrcStartMs": 62656,
      "qrcText": "トキメキ諦めるとか (ムリムリ)"
    },
    {
      "frameId": "l035",
      "mode": "full",
      "qrcStartMs": 65279,
      "qrcText": "ムリくり振りまいたキラキラ"
    },
    {
      "frameId": "l036",
      "mode": "full",
      "qrcStartMs": 67860,
      "qrcText": "キミに気づかれるかもだとか"
    },
    {
      "frameId": "l037",
      "mode": "full",
      "qrcStartMs": 70653,
      "qrcText": "巡らせるハートは"
    },
    {
      "frameId": "l038",
      "mode": "full",
      "qrcStartMs": 71770,
      "qrcText": "キミに近づきたい"
    },
    {
      "frameId": "l039",
      "mode": "full",
      "qrcStartMs": 74340,
      "qrcText": "アワナビア陽サイ"
    },
    {
      "frameId": "l040",
      "mode": "full",
      "qrcStartMs": 75452,
      "qrcText": "(ムリムリ)"
    },
    {
      "frameId": "l041",
      "mode": "full",
      "qrcStartMs": 76140,
      "qrcText": "ひとよひとよを瞳でキャッチ"
    },
    {
      "frameId": "l042",
      "mode": "full",
      "qrcStartMs": 78075,
      "qrcText": "(ムリムリ)"
    },
    {
      "frameId": "l043",
      "mode": "full",
      "qrcStartMs": 78788,
      "qrcText": "ふたり以上でも大歓迎"
    },
    {
      "frameId": "l044",
      "mode": "full",
      "qrcStartMs": 80683,
      "qrcText": "(ムリムリ)"
    },
    {
      "frameId": "l045",
      "mode": "full",
      "qrcStartMs": 81387,
      "qrcText": "みつめられたら照れちゃうなぁ"
    },
    {
      "frameId": "l046",
      "mode": "full",
      "qrcStartMs": 83332,
      "qrcText": "(ムリムリ)"
    },
    {
      "frameId": "l047",
      "mode": "full",
      "qrcStartMs": 83948,
      "qrcText": "キミのもと進め 光のさす方"
    },
    {
      "frameId": "l048",
      "mode": "full",
      "qrcStartMs": 100032,
      "qrcText": "あぁ やっぱムリかも"
    },
    {
      "frameId": "l049",
      "mode": "full",
      "qrcStartMs": 102686,
      "qrcText": "頑張ったフリだもん"
    },
    {
      "frameId": "l050",
      "mode": "full",
      "qrcStartMs": 104723,
      "qrcText": "そんじゃまた再起動して"
    },
    {
      "frameId": "l051",
      "mode": "full",
      "qrcStartMs": 106431,
      "qrcText": "さらば一同"
    },
    {
      "frameId": "l052",
      "mode": "full",
      "qrcStartMs": 107319,
      "qrcText": "とか内心ゆーてる間に"
    },
    {
      "frameId": "l053",
      "mode": "full",
      "qrcStartMs": 108943,
      "qrcText": "あばばばばば"
    },
    {
      "frameId": "l054",
      "mode": "full",
      "qrcStartMs": 110208,
      "qrcText": "愛嬌あれば苦労しない"
