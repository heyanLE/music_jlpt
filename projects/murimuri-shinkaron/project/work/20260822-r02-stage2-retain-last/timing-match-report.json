    },
    {
      "frameId": "l073",
      "mode": "full",
      "qrcStartMs": 142132,
      "qrcText": "この春をまだ揺れたい"
    },
    {
      "frameId": "l074",
      "mode": "full",
      "qrcStartMs": 145734,
      "qrcText": "陽も陰も 全力でもがいていこうぜ"
    },
    {
      "frameId": "l075",
      "mode": "full",
      "qrcStartMs": 149241,
      "qrcText": "あぁ この陰が在るから"
    },
    {
      "frameId": "l076",
      "mode": "full",
      "qrcStartMs": 151894,
      "qrcText": "キミの陽の暖かさがわかる"
    },
    {
      "frameId": "l077",
      "mode": "full",
      "qrcStartMs": 155423,
      "qrcText": "ムリムリ ムリムリ なんて"
    },
    {
      "frameId": "l078",
      "mode": "full",
      "qrcStartMs": 157864,
      "qrcText": "逃げるには短すぎるワンライフ"
    },
    {
      "frameId": "l079",
      "mode": "full",
      "qrcStartMs": 160792,
      "qrcText": "キミに向けるハートこそ"
    },
    {
      "frameId": "l080",
      "mode": "full",
      "qrcStartMs": 162078,
      "qrcText": "太陽だった"
    },
    {
      "frameId": "l081",
      "mode": "full",
      "qrcStartMs": 163142,
      "qrcText": "こんなドキドキ今しかっ(ムリムリ)"
    },
    {
      "frameId": "l082",
      "mode": "full",
      "qrcStartMs": 166055,
      "qrcText": "秘密裏 積み上げた想いとか"
    },
    {
      "frameId": "l083",
      "mode": "full",
      "qrcStartMs": 168594,
      "qrcText": "キミに伝え足りないんだまだ"
    },
    {
      "frameId": "l084",
      "mode": "full",
      "qrcStartMs": 171340,
      "qrcText": "場違いな逆光さえ"
    },
    {
      "frameId": "l085",
      "mode": "full",
      "qrcStartMs": 172573,
      "qrcText": "キミと近づきたい"
    },
    {
      "frameId": "l086",
      "mode": "full",
