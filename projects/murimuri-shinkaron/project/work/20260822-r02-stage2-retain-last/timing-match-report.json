      "frameId": "l056",
      "mode": "full",
      "qrcStartMs": 112953,
      "qrcText": "勇気がない 言葉が出ない"
    },
    {
      "frameId": "l057",
      "mode": "full",
      "qrcStartMs": 114208,
      "qrcText": "みんなの普通は普通じゃない"
    },
    {
      "frameId": "l058",
      "mode": "full",
      "qrcStartMs": 115407,
      "qrcText": "でも"
    },
    {
      "frameId": "l059",
      "mode": "full",
      "qrcStartMs": 115720,
      "qrcText": "キミの世界に映り込んでみたい"
    },
