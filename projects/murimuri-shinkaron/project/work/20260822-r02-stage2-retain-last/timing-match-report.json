      "frameId": "l060",
      "mode": "full",
      "qrcStartMs": 116792,
      "qrcText": "この気持ち多分嘘じゃない"
    },
    {
      "frameId": "l061",
      "mode": "full",
      "qrcStartMs": 117992,
      "qrcText": "でもでもやっぱ無理です怖いです"
    },
    {
      "frameId": "l062",
      "mode": "full",
      "qrcStartMs": 119384,
      "qrcText": "でもでもでも"
    },
    {
      "frameId": "l063",
      "mode": "full",
      "qrcStartMs": 120140,
      "qrcText": "やっぱ諦めきれないです"
    },
    {
      "frameId": "l064",
      "mode": "full",
      "qrcStartMs": 123400,
      "qrcText": "陰ってばっかなこの心"
    },
    {
      "frameId": "l065",
      "mode": "full",
      "qrcStartMs": 125727,
      "qrcText": "そんな自分に"
    },
    {
      "frameId": "l066",
      "mode": "full",
      "qrcStartMs": 126895,
      "qrcText": "飽いていたんだずっと"
    },
    {
      "frameId": "l067",
      "mode": "full",
      "qrcStartMs": 128843,
      "qrcText": "陰サイ陽サイ飛び越えた"
    },
