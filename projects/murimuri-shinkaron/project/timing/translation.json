{
  "schemaVersion": 1,
  "source": "lyrics_qmts.qrc",
  "lyricType": "regular",
  "lines": [
    {
      "id": "translation-001",
      "startMs": 61340,
      "text": "将会朝着太阳伸展"
    },
    {
      "id": "translation-002",
      "startMs": 62650,
      "text": "要我放弃心动什么的 (不行不行)"
    },
    {
      "id": "translation-003",
      "startMs": 65270,
      "text": "强行播撒而下的那道璀璨光芒"
    },
    {
      "id": "translation-004",
      "startMs": 67860,
      "text": "或许也会存在被你发现的可能"
    },
    {
      "id": "translation-005",
      "startMs": 70650,
      "text": "这颗兜兜转转的心"
    },
    {
      "id": "translation-006",
      "startMs": 71770,
      "text": "希望能够朝你靠近"
    },
    {
      "id": "translation-007",
      "startMs": 74340,
      "text": "我渴望奔赴你的身边"
    },
    {
      "id": "translation-008",
      "startMs": 75450,
      "text": "(不行不行)"
    },
    {
      "id": "translation-009",
      "startMs": 76140,
      "text": "依然要用目光捕捉每个人的身影"
    },
    {
      "id": "translation-010",
      "startMs": 78070,
      "text": "(不行不行)"
    },
    {
      "id": "translation-011",
      "startMs": 78780,
      "text": "就算超过两人也欢迎至极"
    },
    {
      "id": "translation-012",
      "startMs": 80680,
      "text": "(不行不行)"
    },
    {
      "id": "translation-013",
      "startMs": 81380,
      "text": "但是被盯着看还是会觉得害羞啊"
    },
    {
      "id": "translation-014",
      "startMs": 83330,
      "text": "(不行不行)"
    },
    {
      "id": "translation-015",
      "startMs": 83940,
      "text": "朝你身旁前进 奔赴光芒所在"
    },
    {
      "id": "translation-016",
      "startMs": 100030,
      "text": "啊啊 或许还是行不通"
    },
    {
      "id": "translation-017",
      "startMs": 102680,
      "text": "毕竟只是在假装努力"
    },
    {
      "id": "translation-018",
      "startMs": 104720,
      "text": "既然如此我要重启自己了"
    },
    {
      "id": "translation-019",
      "startMs": 106430,
      "text": "再见了各位"
    },
    {
      "id": "translation-020",
      "startMs": 107310,
      "text": "心里正念叨着这些的时候"
    },
    {
      "id": "translation-021",
      "startMs": 108940,
      "text": "突然就手忙脚乱"
    },
    {
      "id": "translation-022",
      "startMs": 110200,
      "text": "若是招人喜欢就不用这么辛苦了"
    },
    {
      "id": "translation-023",
      "startMs": 111560,
      "text": "不过流行的社交话题永远都与我无缘"
    },
    {
      "id": "translation-024",
      "startMs": 112950,
      "text": "缺乏勇气 而且不善言谈"
    },
    {
      "id": "translation-025",
      "startMs": 114200,
      "text": "大家的“普通”其实都不算普通"
    },
    {
      "id": "translation-026",
      "startMs": 115400,
      "text": "但是"
    },
    {
      "id": "translation-027",
      "startMs": 115720,
      "text": "我希望能在你世界有一席之地"
    },
    {
      "id": "translation-028",
      "startMs": 116790,
      "text": "这份心意大概毫无虚假"
    },
    {
      "id": "translation-029",
      "startMs": 117990,
      "text": "但是但是果然我做不到 好可怕"
    },
    {
      "id": "translation-030",
      "startMs": 119380,
      "text": "但是但是但是"
    },
    {
      "id": "translation-031",
      "startMs": 123400,
      "text": "这颗心总是乌云密布"
    },
    {
      "id": "translation-032",
      "startMs": 125720,
      "text": "这样的自己"
    },
    {
      "id": "translation-033",
      "startMs": 126890,
      "text": "一直都让我厌倦无比"
    },
    {
      "id": "translation-034",
      "startMs": 128840,
      "text": "跨越阴暗积极的交界线"
    },
    {
      "id": "translation-035",
      "startMs": 130240,
      "text": "打造自我进化论"
    },
    {
      "id": "translation-036",
      "startMs": 133020,
      "text": "渴望挣脱桎梏我的一切 不论是这个标签"
    },
    {
      "id": "translation-037",
      "startMs": 136340,
      "text": "还是这条早就已经铺好的"
    },
    {
      "id": "translation-038",
      "startMs": 137950,
      "text": "既定轨道"
    },
    {
      "id": "translation-039",
      "startMs": 139310,
      "text": "在前所未有的这个春日里"
    },
    {
      "id": "translation-040",
      "startMs": 142130,
      "text": "仍想感受到动摇的心绪"
    },
    {
      "id": "translation-041",
      "startMs": 145730,
      "text": "不论阳光还是阴影 都要用尽全力挣扎向前"
    },
    {
      "id": "translation-042",
      "startMs": 149240,
      "text": "啊啊 正因有阴影的存在"
    },
    {
      "id": "translation-043",
      "startMs": 151890,
      "text": "我才更懂你的阳光有多温暖"
    },
    {
      "id": "translation-044",
      "startMs": 155420,
      "text": "嘴上说着不行不行 不行不行"
    },
    {
      "id": "translation-045",
      "startMs": 157860,
      "text": "可用来逃避的一生实在是太过短暂"
    },
    {
      "id": "translation-046",
      "startMs": 160790,
      "text": "我这颗始终都向着你的心"
    },
    {
      "id": "translation-047",
      "startMs": 162070,
      "text": "本就是太阳"
    },
    {
      "id": "translation-048",
      "startMs": 163140,
      "text": "这份悸动只属于此时此刻 (不行不行)"
    },
    {
      "id": "translation-049",
      "startMs": 166050,
      "text": "秘密下 积攒累积的这份思念"
    },
    {
      "id": "translation-050",
      "startMs": 168590,
      "text": "其实还远远没有尽数传达给你"
    },
    {
      "id": "translation-051",
      "startMs": 171340,
      "text": "面对不合时宜的逆光"
    },
    {
      "id": "translation-052",
      "startMs": 172570,
      "text": "我依然想要朝你靠近"
    },
    {
      "id": "translation-053",
      "startMs": 175130,
      "text": "我渴望奔赴你的身边"
    },
    {
      "id": "translation-054",
      "startMs": 176460,
      "text": "若是感到疲惫的话"
    },
    {
      "id": "translation-055",
      "startMs": 177800,
      "text": "那就回归阴暗面的怀抱吧"
    },
    {
      "id": "translation-056",
      "startMs": 178890,
      "text": "(不行不行)"
    },
    {
      "id": "translation-057",
      "startMs": 179580,
      "text": "依然要用目光捕捉每个人的身影"
    },
    {
      "id": "translation-058",
      "startMs": 181460,
      "text": "(不行不行)"
    },
    {
      "id": "translation-059",
      "startMs": 182150,
      "text": "就算超过两人也欢迎至极"
    },
    {
      "id": "translation-060",
      "startMs": 184010,
      "text": "(不行不行)"
    },
    {
      "id": "translation-061",
      "startMs": 184670,
      "text": "但是被盯着看还是会觉得害羞啊"
    },
    {
      "id": "translation-062",
      "startMs": 186770,
      "text": "(不行不行)"
    },
    {
      "id": "translation-063",
      "startMs": 187480,
      "text": "朝你身旁前进 奔赴光芒所在"
    }
  ]
}
