{
  "schemaVersion": 1,
  "foreground": {
    "templateId": "study-current-v3",
    "visibleDuringNoLyric": false,
    "veil": { "mode": "lyric-only", "color": "#000000", "opacity": 0.28 },
    "highlight": { "mode": "token" },
    "textOutline": { "enabled": true, "color": "#000000" }
  },
  "sceneOverrides": {
    "stage2-cover-gaussian": {
      "visibleDuringNoLyric": true,
      "gapBehavior": "retain-last-frame",
      "veil": { "mode": "persistent-learning-foreground", "color": "#000000", "opacity": 0.28 },
      "description": "From the cover-gaussian scene onward, retain the last complete lyric foreground until the next lyric state begins."
    }
  },
  "floatingOverlay": {
    "id": "foobar-realtime-bars",
    "enabled": true,
    "persistent": true,
    "zIndex": "above-foreground",
    "audioClock": "audio",
    "style": "log-frequency-bars",
    "transparent": true,
    "alwaysAnimate": true
  },
  "coverBadge": { "enabled": true, "text": "Hi-Res 无损音质" }
}
