{
  "schemaVersion": 1,
  "format": "lrc-line-timed",
  "lines": [
    {
      "startMs": 0,
      "text": "TME享有本翻译作品的著作权",
      "endMs": 6520,
      "durationMs": 6520
    },
    {
      "startMs": 6520,
      "text": "//",
      "endMs": 11210,
      "durationMs": 4690
    },
    {
      "startMs": 11210,
      "text": "//",
      "endMs": 17490,
      "durationMs": 6280
    },
    {
      "startMs": 17490,
      "text": "还剩一茶匙的忧郁就要濒临崩溃",
      "endMs": 23030,
      "durationMs": 5540
    },
    {
      "startMs": 23030,
      "text": "毫不介意他人言语",
      "endMs": 25210,
      "durationMs": 2180
    },
    {
      "startMs": 25210,
      "text": "记忆领域遭到压缩",
      "endMs": 28890,
      "durationMs": 3680
    },
    {
      "startMs": 28890,
      "text": "就算受挫跌倒 依然靠着心中",
      "endMs": 32270,
      "durationMs": 3380
    },
    {
      "startMs": 32270,
      "text": "未被验证的哲学坚持振作",
      "endMs": 34590,
      "durationMs": 2320
    },
    {
      "startMs": 34590,
      "text": "只是连自己都无法骗过的",
      "endMs": 36770,
      "durationMs": 2180
    },
    {
      "startMs": 36770,
      "text": "廉价的理论武装",
      "endMs": 40550,
      "durationMs": 3780
    },
    {
      "startMs": 40550,
      "text": "等有了答案再说",
      "endMs": 43800,
      "durationMs": 3250
    },
    {
      "startMs": 43800,
      "text": "=永远不会有答案",
      "endMs": 46400,
      "durationMs": 2600
    },
    {
      "startMs": 46400,
      "text": "这转个不停的头脑",
      "endMs": 49420,
      "durationMs": 3020
    },
    {
      "startMs": 49420,
      "text": "有谁能够帮我停下",
      "endMs": 54010,
      "durationMs": 4590
    },
    {
      "startMs": 54010,
      "text": "干脆彻底忘却一切",
      "endMs": 56640,
      "durationMs": 2630
    },
    {
      "startMs": 56640,
      "text": "今夜 于影色下起舞",
      "endMs": 60010,
      "durationMs": 3370
    },
    {
      "startMs": 60010,
      "text": "一无所知 亦无所求",
      "endMs": 61500,
      "durationMs": 1490
    },
    {
      "startMs": 61500,
      "text": "不被任何规则束缚",
      "endMs": 62810,
      "durationMs": 1310
    },
    {
      "startMs": 62810,
      "text": "只愿自由自在 恣意起舞",
      "endMs": 64270,
      "durationMs": 1460
    },
    {
      "startMs": 64270,
      "text": "（赞颂今天吧）",
      "endMs": 65670,
      "durationMs": 1400
    },
    {
      "startMs": 65670,
      "text": "熄灭所有灯光照明",
      "endMs": 68550,
      "durationMs": 2880
    },
    {
      "startMs": 68550,
      "text": "来吧 与宇宙连结相通",
      "endMs": 70700,
      "durationMs": 2150
    },
    {
      "startMs": 70700,
      "text": "踩着节奏 浮在半空",
      "endMs": 73990,
      "durationMs": 3290
    },
    {
      "startMs": 73990,
      "text": "跳起超凡脱俗的影色之舞",
      "endMs": 89040,
      "durationMs": 15050
    },
    {
      "startMs": 89040,
      "text": "我的现实",
      "endMs": 92210,
      "durationMs": 3170
    },
    {
      "startMs": 92210,
      "text": "逐渐融入音韵之中",
      "endMs": 94470,
      "durationMs": 2260
    },
    {
      "startMs": 94470,
      "text": "伤感与焦躁也支离破碎",
      "endMs": 98180,
      "durationMs": 3710
    },
    {
      "startMs": 98180,
      "text": "随风凋零散去",
      "endMs": 100560,
      "durationMs": 2380
    },
    {
      "startMs": 100560,
      "text": "五脏六腑中回响不止的",
      "endMs": 103770,
      "durationMs": 3210
    },
    {
      "startMs": 103770,
      "text": "是脉搏连缀而成的旋律",
      "endMs": 106170,
      "durationMs": 2400
    },
    {
      "startMs": 106170,
      "text": "在我的浑身上下游走",
      "endMs": 108340,
      "durationMs": 2170
    },
    {
      "startMs": 108340,
      "text": "化作跃动飞驰的流星",
      "endMs": 112110,
      "durationMs": 3770
    },
    {
      "startMs": 112110,
      "text": "汹涌的音浪",
      "endMs": 115400,
      "durationMs": 3290
    },
    {
      "startMs": 115400,
      "text": "逐渐与呼吸重合",
      "endMs": 117850,
      "durationMs": 2450
    },
    {
      "startMs": 117850,
      "text": "想要随着音浪尽情摇摆",
      "endMs": 120920,
      "durationMs": 3070
    },
    {
      "startMs": 120920,
      "text": "仅此而已便心满意足",
      "endMs": 124150,
      "durationMs": 3230
    },
    {
      "startMs": 124150,
      "text": "既然飞跃大气层来到宇宙",
      "endMs": 126800,
      "durationMs": 2650
    },
    {
      "startMs": 126800,
      "text": "就在那真空之中 漂浮起舞",
      "endMs": 130190,
      "durationMs": 3390
    },
    {
      "startMs": 130190,
      "text": "毫无意义 大错特错",
      "endMs": 131580,
      "durationMs": 1390
    },
    {
      "startMs": 131580,
      "text": "丝毫不用担心",
      "endMs": 132870,
      "durationMs": 1290
    },
    {
      "startMs": 132870,
      "text": "只管淋漓尽致 放肆舞动",
      "endMs": 134480,
      "durationMs": 1610
    },
    {
      "startMs": 134480,
      "text": "（盲目相信直觉）",
      "endMs": 135760,
      "durationMs": 1280
    },
    {
      "startMs": 135760,
      "text": "无法创造出任何事物",
      "endMs": 138630,
      "durationMs": 2870
    },
    {
      "startMs": 138630,
      "text": "啊啊 透彻明晰的自由",
      "endMs": 140810,
      "durationMs": 2180
    },
    {
      "startMs": 140810,
      "text": "若将这一切重置 化为乌有",
      "endMs": 158270,
      "durationMs": 17460
    },
    {
      "startMs": 158270,
      "text": "把宇宙当做云端",
      "endMs": 161670,
      "durationMs": 3400
    },
    {
      "startMs": 161670,
      "text": "将一切存入其中",
      "endMs": 170420,
      "durationMs": 8750
    },
    {
      "startMs": 170420,
      "text": "干脆彻底忘却一切",
      "endMs": 173040,
      "durationMs": 2620
    },
    {
      "startMs": 173040,
      "text": "今夜 于影色下起舞",
      "endMs": 176340,
      "durationMs": 3300
    },
    {
      "startMs": 176340,
      "text": "一无所知 亦无所求",
      "endMs": 177820,
      "durationMs": 1480
    },
    {
      "startMs": 177820,
      "text": "不被任何规则束缚",
      "endMs": 179190,
      "durationMs": 1370
    },
    {
      "startMs": 179190,
      "text": "只愿自由自在 恣意起舞",
      "endMs": 180710,
      "durationMs": 1520
    },
    {
      "startMs": 180710,
      "text": "（赞颂今天吧）",
      "endMs": 182040,
      "durationMs": 1330
    },
    {
      "startMs": 182040,
      "text": "必然无人知晓的夜晚",
      "endMs": 185500,
      "durationMs": 3460
    },
    {
      "startMs": 185500,
      "text": "是属于我的夜晚",
      "endMs": 187120,
      "durationMs": 1620
    },
    {
      "startMs": 187120,
      "text": "即使身披星光 仍难掩哀愁",
      "endMs": 190350,
      "durationMs": 3230
    },
    {
      "startMs": 190350,
      "text": "跳起前卫脱俗的影色之舞",
      "endMs": 209453,
      "durationMs": 19103
    }
  ]
}
