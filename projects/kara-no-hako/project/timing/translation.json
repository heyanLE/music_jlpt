  "lines": [
    {
      "startMs": 570,
      "text": "留存大片空白 时间太过漫长",
      "endMs": 3940,
      "durationMs": 3370
    },
    {
      "startMs": 3940,
      "text": "大概所谓的答案",
      "endMs": 5500,
      "durationMs": 1560
    },
    {
      "startMs": 5500,
      "text": "都是徒有其表的常识吧",
      "endMs": 9150,
      "durationMs": 3650
    },
    {
      "startMs": 9150,
      "text": "哪怕指尖不住地颤抖",
      "endMs": 13810,
      "durationMs": 4660
    },
    {
      "startMs": 13810,
      "text": "此刻我遇到了一条在地图上",
      "endMs": 17930,
      "durationMs": 4120
    },
    {
      "startMs": 17930,
      "text": "不曾标注的三岔路口",
      "endMs": 20450,
      "durationMs": 2520
    },
    {
      "startMs": 20450,
      "text": "究竟我应该",
      "endMs": 23150,
      "durationMs": 2700
    },
    {
      "startMs": 23150,
      "text": "依靠什么继续前进下去呢",
      "endMs": 27200,
      "durationMs": 4050
    },
    {
      "startMs": 27200,
      "text": "常言道只需遵循课本上所示",
      "endMs": 30520,
      "durationMs": 3320
    },
    {
      "startMs": 30520,
      "text": "却全是些晦涩难懂的话",
      "endMs": 33100,
      "durationMs": 2580
    },
    {
      "startMs": 33100,
      "text": "今天从那时开始便没有丝毫的改变",
      "endMs": 39910,
      "durationMs": 6810
    },
    {
      "startMs": 39910,
      "text": "只要将空白栏填满就能解决问题了吗",
      "endMs": 45060,
      "durationMs": 5150
    },
    {
      "startMs": 45060,
      "text": "究竟要到何时",
      "endMs": 46800,
      "durationMs": 1740
    },
    {
      "startMs": 46800,
      "text": "若是你面对这样的情况",
      "endMs": 49760,
      "durationMs": 2960
    },
    {
      "startMs": 49760,
      "text": "又会如何前进呢",
      "endMs": 52400,
      "durationMs": 2640
    },
    {
      "startMs": 52400,
      "text": "留存大片空白 时间太过漫长",
      "endMs": 55730,
      "durationMs": 3330
    },
    {
      "startMs": 55730,
      "text": "大概所谓的答案",
      "endMs": 57350,
      "durationMs": 1620
    },
    {
      "startMs": 57350,
      "text": "都是徒有其表的常识吧",
      "endMs": 61020,
      "durationMs": 3670
    },
    {
      "startMs": 61020,
      "text": "哪怕指尖不住地颤抖",
      "endMs": 65540,
      "durationMs": 4520
    },
    {
      "startMs": 65540,
      "text": "不存在正确答案",
      "endMs": 67140,
      "durationMs": 1600
    },
    {
      "startMs": 67140,
      "text": "更不存在所谓的失败",
      "endMs": 68670,
      "durationMs": 1530
    },
    {
      "startMs": 68670,
      "text": "我终其一生",
      "endMs": 70340,
      "durationMs": 1670
    },
    {
      "startMs": 70340,
      "text": "都只会活出我自己而已吧",
      "endMs": 74030,
      "durationMs": 3690
    },
    {
      "startMs": 74030,
      "text": "哪怕将一切颠覆搅乱仍不会迎来明天",
      "endMs": 85240,
      "durationMs": 11210
    },
    {
      "startMs": 85240,
      "text": "我们因这张无用的地图才在当下",
      "endMs": 89420,
      "durationMs": 4180
    },
    {
      "startMs": 89420,
      "text": "感到如此束手无策的",
      "endMs": 91880,
      "durationMs": 2460
    },
    {
      "startMs": 91880,
      "text": "哪怕固执逞强",
      "endMs": 93910,
      "durationMs": 2030
    },
    {
      "startMs": 93910,
      "text": "结果大概也是一样",
      "endMs": 98740,
      "durationMs": 4830
    },
    {
      "startMs": 98740,
      "text": "将自己的箱子强塞到快要满溢后",
      "endMs": 102050,
      "durationMs": 3310
    },
    {
      "startMs": 102050,
      "text": "才想起瞥一眼他人的箱子",
      "endMs": 104500,
      "durationMs": 2450
    },
    {
      "startMs": 104500,
      "text": "甚至连僵硬的谄笑",
      "endMs": 107300,
      "durationMs": 2800
    },
    {
      "startMs": 107300,
      "text": "我都没有办法强扯",
      "endMs": 111350,
      "durationMs": 4050
    },
    {
      "startMs": 111350,
      "text": "多希望这片空白栏并不存在",
      "endMs": 114580,
      "durationMs": 3230
    },
    {
      "startMs": 114580,
      "text": "你也是如此作想的吧",
      "endMs": 118180,
      "durationMs": 3600
    },
    {
      "startMs": 118180,
      "text": "只要维持现状就可以",
      "endMs": 121130,
      "durationMs": 2950
    },
    {
      "startMs": 121130,
      "text": "这种想法才是错的",
      "endMs": 138610,
      "durationMs": 17480
    },
    {
      "startMs": 138610,
      "text": "本就空白一片 一个字都不曾填写",
      "endMs": 141640,
      "durationMs": 3030
    },
    {
      "startMs": 141640,
      "text": "根本就分不清楚",
      "endMs": 143280,
      "durationMs": 1640
    },
    {
      "startMs": 143280,
      "text": "这是一种失去还是新的开始",
      "endMs": 147000,
      "durationMs": 3720
    },
    {
      "startMs": 147000,
      "text": "可是前进便是唯一的方法吧？",
      "endMs": 151670,
      "durationMs": 4670
    },
    {
      "startMs": 151670,
      "text": "正确答案是什么 毫无价值可言",
      "endMs": 154640,
      "durationMs": 2970
    },
    {
      "startMs": 154640,
      "text": "我终其一生",
      "endMs": 156230,
      "durationMs": 1590
    },
    {
      "startMs": 156230,
      "text": "都无法活成其他人的模样",
      "endMs": 160050,
      "durationMs": 3820
    },
    {
      "startMs": 160050,
      "text": "哪怕将一切颠覆搅乱仍不会迎来明天",
      "endMs": 174500,
      "durationMs": 14450
    },
    {
      "startMs": 174500,
      "text": "如何竭力挣扎都不会迎来明天",
      "endMs": 183844,
      "durationMs": 9344
    }
  ]
}
