{
  "id": "study-v1",
  "version": 1,
  "canvas": { "width": 1920, "height": 1080, "fps": 30 },
  "font": { "family": "CJK bold", "weight": 700 },
  "colors": {
    "body": "palette.body",
    "active": "palette.activeTint",
    "cardFill": "palette.cardFill",
    "cardOutline": "palette.activeTint"
  },
  "veil": { "color": "#000000", "opacity": 0.28, "layer": "below-foreground" },
  "cover": { "x": 0.443, "y": 0.032, "width": 0.115, "height": 0.204, "fit": "cover" },
  "lyric": {
    "mode": "single-inline-unit-row",
    "unitOrder": "caption-source-order",
    "furigana": { "y": 0.273, "size": 28, "kanjiOnly": true, "align": "left-to-kanji-run" },
    "japanese": { "y": 0.306, "size": 70 },
    "english": { "y": 0.326, "size": 42, "hasFurigana": false, "hasRomaji": false },
    "romaji": { "y": 0.398, "size": 34, "japaneseOnly": true },
    "translation": { "y": 0.463, "size": 45, "align": "center" },
    "highlight": {
      "source": "qrc-word-timing",
      "targets": ["japanese", "furigana", "romaji", "english"],
      "fallback": "japanese-only-without-index-shift",
      "stateModel": "render-one-complete-layer-per-active-unit"
    }
  },
  "cards": {
    "x": 0.049, "y": 0.556, "width": 0.902, "height": 0.231,
    "gap": 12, "radius": 20,
    "fields": ["token", "zhMeaning-or-functionZh", "posZh"],
    "meaningMaxLines": 2, "activeHighlight": false
  },
  "noLyric": { "default": "transparent", "cover-wave": "retain-last-foreground-clear-highlight" },
  "spectrumBackground": {
    "cover-wave": { "placement": "background", "style": "ring-style-bottom-bars", "bands": 96, "alwaysAnimate": true }
  }
}
