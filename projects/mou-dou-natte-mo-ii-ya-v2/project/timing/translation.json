  },
  {
    "startMs": 7470,
    "text": "奇妙幻想逡巡于脑海之中"
  },
  {
    "startMs": 8930,
    "text": "按选集所示将谜题抽丝剥茧"
  },
  {
    "startMs": 10780,
    "text": "行动全都遵循本能"
  },
  {
    "startMs": 12100,
    "text": "冲动因悸动而高涨"
  },
  {
    "startMs": 13600,
    "text": "//"
  },
  {
    "startMs": 14540,
    "text": "反正 一切早就无所谓了吧"
  },
  {
    "startMs": 23050,
    "text": "我只想知晓那些理所当然的真相"
  },
  {
    "startMs": 26650,
    "text": "对着星星许愿袒露真心"
  },
  {
    "startMs": 30470,
    "text": "那些迫不得已的借口"
  },
  {
    "startMs": 33820,
    "text": "没有必要 毫无意义"
  },
  {
    "startMs": 35600,
    "text": "你对此如何作想?"
  },
  {
    "startMs": 37420,
    "text": "似乎早就已经失去了归所"
  },
  {
    "startMs": 40980,
    "text": "心中荆棘丛生"
  },
  {
    "startMs": 44940,
    "text": "只是一味地重复着同样的事情"
  },
  {
    "startMs": 48330,
    "text": "在鸟笼之中翩然起舞"
  },
  {
    "startMs": 52020,
    "text": "进退两难 洞悉真相 直至粉饰太平之前"
  },
  {
    "startMs": 53810,
    "text": "都在竭力描绘 大声哭喊 愿一切不要消散"
  },
  {
    "startMs": 55660,
    "text": "这些都是如魔法般方便自我的说辞"
  },
  {
    "startMs": 57460,
    "text": "身为主角就要恪守剧情的起承转合"
  },
  {
    "startMs": 59190,
    "text": "最后不论如何都会是皆大欢喜的结局"
  },
  {
    "startMs": 61280,
    "text": "既然如此就让我随心所欲"
  },
  {
    "startMs": 63390,
    "text": "反正 一切早就无所谓了吧"
  },
  {
    "startMs": 66080,
    "text": "身体上下颠倒一头坠落而下"
  },
  {
    "startMs": 67770,
    "text": "在失去重力的午夜逃避现实"
  },
  {
    "startMs": 70030,
    "text": "秘密显形之后惹得彼此深深沉沦"
  },
  {
    "startMs": 73290,
    "text": "将一切统统都带走吧"
  },
  {
    "startMs": 74830,
    "text": "毫无保留地歌颂人生"
  },
  {
    "startMs": 77260,
    "text": "仰望交织的群星任思绪驰骋"
  },
  {
    "startMs": 80110,
    "text": "//"
  },
  {
    "startMs": 80680,
    "text": "感慨着月色的美丽"
  },
  {
    "startMs": 83100,
    "text": "这世界的一切本就是奇迹"
  },
  {
    "startMs": 85730,
    "text": "为爱讴歌"
  },
  {
    "startMs": 95250,
    "text": "反正 一切早就无所谓了吧"
  },
  {
    "startMs": 96660,
    "text": "因暧昧的笑容心生动摇"
  },
  {
    "startMs": 99030,
    "text": "我要将焦距"
  },
  {
    "startMs": 101440,
    "text": "对准你眼眸深处"
  },
  {
    "startMs": 104110,
    "text": "步入那从未有人踏足的真实乐园"
  },
  {
    "startMs": 106260,
    "text": "被雨水淋湿的身体躁动不安"
  },
  {
    "startMs": 107670,
    "text": "绽放自身光彩绝非一件易事"
  },
  {
    "startMs": 109130,
    "text": "就让我更加更加更加更加盲目而行"
  },
  {
    "startMs": 111160,
    "text": "希望在疯狂中将一切都袒露而出"
  },
  {
    "startMs": 112980,
    "text": "数着1 2 3让心灵与人生得到充盈"
  },
  {
    "startMs": 114760,
    "text": "这些都是如魔法般方便自我的说辞"
  },
  {
    "startMs": 116600,
    "text": "可我仍心甘情愿将其当做了寄托"
  },
  {
    "startMs": 118370,
    "text": "选择放弃之后注定是糟糕的结局"
  },
  {
    "startMs": 120460,
    "text": "耗尽最后一丝勇气"
  },
  {
    "startMs": 122420,
    "text": "反正一切早就无所谓了吧"
  },
  {
    "startMs": 128040,
    "text": "如同火花般燃烧的证明"
  },
  {
    "startMs": 131770,
    "text": "终有一天会被彻底地遗忘"
  },
  {
    "startMs": 134330,
    "text": "“真虚幻啊”如此感慨着为感情夹上书签"
  },
  {
    "startMs": 139540,
    "text": "这样就能彰显特别了吧"
  },
  {
    "startMs": 143030,
    "text": "恪守正道最后反而遭到漠视"
  },
  {
    "startMs": 144830,
    "text": "遁入寂静暮色中逃避现实"
  },
  {
    "startMs": 146970,
    "text": "让距离拉近到可以感触到那份温暖"
  },
  {
    "startMs": 150530,
    "text": "这个月之泪倾洒的世界如同异邦"
  },
  {
    "startMs": 154670,
    "text": "仍要叫嚣对爱的渴望"
  },
