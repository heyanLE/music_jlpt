{
  "schemaVersion": 1,
  "format": "lrc-line-timed",
  "lines": [
    {
      "startMs": 650,
      "text": "仍旧尚存的心跳充斥于这个夜晚",
      "endMs": 3400,
      "durationMs": 2750
    },
    {
      "startMs": 3400,
      "text": "在粉身碎骨前将我们包覆其中",
      "endMs": 6260,
      "durationMs": 2860
    },
    {
      "startMs": 6260,
      "text": "哪怕不去依赖那双援手也无妨",
      "endMs": 8100,
      "durationMs": 1840
    },
    {
      "startMs": 8100,
      "text": "这双手正是属于你自己的",
      "endMs": 10800,
      "durationMs": 2700
    },
    {
      "startMs": 10800,
      "text": "一切应该都能改换一新",
      "endMs": 12500,
      "durationMs": 1700
    },
    {
      "startMs": 12500,
      "text": "就此伸出手吧",
      "endMs": 19180,
      "durationMs": 6680
    },
    {
      "startMs": 19180,
      "text": "在拥挤的人潮中无声地落下泪水",
      "endMs": 23470,
      "durationMs": 4290
    },
    {
      "startMs": 23470,
      "text": "足迹留存于此刻 在清晨将某人的声音抹消殆尽",
      "endMs": 27770,
      "durationMs": 4300
    },
    {
      "startMs": 27770,
      "text": "不论何时都不会历经枯朽",
      "endMs": 31740,
      "durationMs": 3970
    },
    {
      "startMs": 31740,
      "text": "腐败城市的泥水尽显冰冷",
      "endMs": 36540,
      "durationMs": 4800
    },
    {
      "startMs": 36540,
      "text": "置身于无所改变的世界",
      "endMs": 39370,
      "durationMs": 2830
    },
    {
      "startMs": 39370,
      "text": "我们依然竭力地活在今天",
      "endMs": 41710,
      "durationMs": 2340
    },
    {
      "startMs": 41710,
      "text": "虽然毫无意义 却也无可奈何吧",
      "endMs": 44180,
      "durationMs": 2470
    },
    {
      "startMs": 44180,
      "text": "我们已经开始迈出步伐了",
      "endMs": 47280,
      "durationMs": 3100
    },
    {
      "startMs": 47280,
      "text": "不可置信般 恍若傻瓜般",
      "endMs": 50200,
      "durationMs": 2920
    },
    {
      "startMs": 50200,
      "text": "我们的城市已是无药可救",
      "endMs": 52910,
      "durationMs": 2710
    },
    {
      "startMs": 52910,
      "text": "即便如此",
      "endMs": 53750,
      "durationMs": 840
    },
    {
      "startMs": 53750,
      "text": "我们依然亲眼见证了一切",
      "endMs": 55110,
      "durationMs": 1360
    },
    {
      "startMs": 55110,
      "text": "我们依然亲手碰触到一切",
      "endMs": 56410,
      "durationMs": 1300
    },
    {
      "startMs": 56410,
      "text": "呐 你看 你看",
      "endMs": 58300,
      "durationMs": 1890
    },
    {
      "startMs": 58300,
      "text": "你看 微风再次拂起 像个傻瓜般",
      "endMs": 61310,
      "durationMs": 3010
    },
    {
      "startMs": 61310,
      "text": "照亮这令人莫可奈何的黑暗吧",
      "endMs": 64140,
      "durationMs": 2830
    },
    {
      "startMs": 64140,
      "text": "并非一场梦境",
      "endMs": 64970,
      "durationMs": 830
    },
    {
      "startMs": 64970,
      "text": "反正这座城市最后会迎来终焉",
      "endMs": 66370,
      "durationMs": 1400
    },
    {
      "startMs": 66370,
      "text": "就算放弃也改变不了事实吧",
      "endMs": 67770,
      "durationMs": 1400
    },
    {
      "startMs": 67770,
      "text": "啊啊 一切依然是如此",
      "endMs": 70080,
      "durationMs": 2310
    },
    {
      "startMs": 70080,
      "text": "仍旧尚存的心跳充斥于这个夜晚",
      "endMs": 72870,
      "durationMs": 2790
    },
    {
      "startMs": 72870,
      "text": "在粉身碎骨前将我们包覆其中",
      "endMs": 75680,
      "durationMs": 2810
