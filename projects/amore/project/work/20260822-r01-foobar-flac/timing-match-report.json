      "qrcText": "明日 きみがいないのなら"
    },
    {
      "frameId": "l008",
      "mode": "full",
      "qrcStartMs": 34797,
      "qrcText": "僕は後悔するのだろう"
    },
    {
      "frameId": "l009",
      "mode": "full",
      "qrcStartMs": 38009,
      "qrcText": "言えなかった言葉たちが"
    },
    {
      "frameId": "l010",
      "mode": "full",
      "qrcStartMs": 41030,
      "qrcText": "棘になって刺さるのだろう"
    },
    {
      "frameId": "l011",
      "mode": "full",
      "qrcStartMs": 44247,
      "qrcText": "明日 きみがいないのなら"
    },
    {
      "frameId": "l012",
      "mode": "full",
      "qrcStartMs": 47298,
      "qrcText": "僕はどうなっちゃうんだろう"
    },
    {
      "frameId": "l013",
      "mode": "full",
      "qrcStartMs": 50341,
      "qrcText": "そんな事考えてたら"
    },
    {
      "frameId": "l014",
      "mode": "full",
      "qrcStartMs": 53457,
      "qrcText": "きみに会いたくなったんだよ"
    },
    {
      "frameId": "l015",
      "mode": "full",
      "qrcStartMs": 56695,
      "qrcText": "明日 きみと生きれるなら"
    },
    {
      "frameId": "l016",
      "mode": "full",
      "qrcStartMs": 59785,
      "qrcText": "毎日記念日にして祝おう"
    },
    {
      "frameId": "l017",
      "mode": "full",
      "qrcStartMs": 62806,
      "qrcText": "あたりまえにある奇跡を"
    },
    {
      "frameId": "l018",
      "mode": "full",
      "qrcStartMs": 65901,
      "qrcText": "決して忘れはしないように"
    },
    {
      "frameId": "l019",
      "mode": "full",
      "qrcStartMs": 69143,
      "qrcText": "明日 きみと生きれるなら"
    },
    {
      "frameId": "l020",
      "mode": "full",
      "qrcStartMs": 72315,
      "qrcText": "明日 きみと話せるなら"
    },
