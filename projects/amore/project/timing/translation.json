  "lines": [
    {
      "startMs": 690,
      "text": "好想见你 我真的好想见你",
      "endMs": 19330,
      "durationMs": 18640
    },
    {
      "startMs": 19330,
      "text": "若是世上存在一种",
      "endMs": 22450,
      "durationMs": 3120
    },
    {
      "startMs": 22450,
      "text": "能将你与我加在一起之后",
      "endMs": 26330,
      "durationMs": 3880
    },
    {
      "startMs": 26330,
      "text": "再掰作两半的魔法",
      "endMs": 28590,
      "durationMs": 2260
    },
    {
      "startMs": 28590,
      "text": "我们能否拥有",
      "endMs": 30070,
      "durationMs": 1480
    },
    {
      "startMs": 30070,
      "text": "没有离别的永恒呢",
      "endMs": 31870,
      "durationMs": 1800
    },
    {
      "startMs": 31870,
      "text": "明天 若是身边不再有你",
      "endMs": 34790,
      "durationMs": 2920
    },
    {
      "startMs": 34790,
      "text": "我大概会感到后悔吧",
      "endMs": 38000,
      "durationMs": 3210
    },
    {
      "startMs": 38000,
      "text": "那些没能说出口的话语",
      "endMs": 41030,
      "durationMs": 3030
    },
    {
      "startMs": 41030,
      "text": "将化作荆棘刺痛我的心吧",
      "endMs": 44240,
      "durationMs": 3210
    },
    {
      "startMs": 44240,
      "text": "明天 若是身边不再有你",
      "endMs": 47290,
      "durationMs": 3050
    },
    {
      "startMs": 47290,
      "text": "那我究竟又会变成什么模样",
      "endMs": 50340,
      "durationMs": 3050
    },
    {
      "startMs": 50340,
      "text": "只要一想到这些",
      "endMs": 53450,
      "durationMs": 3110
    },
    {
      "startMs": 53450,
      "text": "我便会涌现出想见你的冲动",
      "endMs": 56690,
      "durationMs": 3240
    },
    {
      "startMs": 56690,
      "text": "明天 若是还能与你共度",
      "endMs": 59780,
      "durationMs": 3090
    },
    {
      "startMs": 59780,
      "text": "那就把每天都当纪念日来庆祝",
      "endMs": 62800,
      "durationMs": 3020
    },
    {
      "startMs": 62800,
      "text": "只愿将习以为常的奇迹",
      "endMs": 65900,
      "durationMs": 3100
    },
    {
      "startMs": 65900,
      "text": "全部都铭记于心绝不忘记",
      "endMs": 69140,
      "durationMs": 3240
    },
    {
      "startMs": 69140,
      "text": "明天 希望还能与你共度",
      "endMs": 72310,
      "durationMs": 3170
    },
    {
      "startMs": 72310,
      "text": "明天 希望还能与你交谈",
      "endMs": 75400,
      "durationMs": 3090
    },
    {
      "startMs": 75400,
      "text": "明天 希望还能与你一同欢笑",
      "endMs": 78500,
      "durationMs": 3100
    },
    {
      "startMs": 78500,
      "text": "会有这样的期盼 都是因为遇到了你",
      "endMs": 81570,
      "durationMs": 3070
    },
    {
      "startMs": 81570,
      "text": "我啊 我啊 一定是个很幸福的人",
      "endMs": 100480,
      "durationMs": 18910
    },
    {
      "startMs": 100480,
      "text": "呐 若是我们还可以",
      "endMs": 103500,
      "durationMs": 3020
    },
    {
      "startMs": 103500,
      "text": "多拥有几颗心脏",
      "endMs": 107340,
      "durationMs": 3840
    },
    {
      "startMs": 107340,
      "text": "我是不是就能",
      "endMs": 109690,
      "durationMs": 2350
    },
    {
      "startMs": 109690,
      "text": "与你一起",
      "endMs": 110540,
      "durationMs": 850
    },
    {
      "startMs": 110540,
      "text": "在世上生活到厌倦为止",
      "endMs": 112940,
      "durationMs": 2400
    },
    {
      "startMs": 112940,
      "text": "呐 究竟我们之后",
      "endMs": 115880,
      "durationMs": 2940
    },
    {
      "startMs": 115880,
      "text": "还要跨越多少绝望",
      "endMs": 119840,
      "durationMs": 3960
    },
    {
      "startMs": 119840,
      "text": "才能在这世上",
      "endMs": 122250,
      "durationMs": 2410
    },
    {
      "startMs": 122250,
      "text": "与你一起迎来",
      "endMs": 123850,
      "durationMs": 1600
    },
    {
      "startMs": 123850,
      "text": "那个幸福结局呢 呐",
      "endMs": 126060,
      "durationMs": 2210
    },
    {
      "startMs": 126060,
      "text": "那些原本该在未来的几十年里",
      "endMs": 129940,
      "durationMs": 3880
    },
    {
      "startMs": 129940,
      "text": "对你说的",
      "endMs": 132030,
      "durationMs": 2090
    },
    {
      "startMs": 132030,
      "text": "“欢迎回来”“我出门了”“早安”",
      "endMs": 134570,
      "durationMs": 2540
    },
    {
      "startMs": 134570,
      "text": "“晚安”“谢谢你”“对不起”",
      "endMs": 136990,
      "durationMs": 2420
    },
    {
      "startMs": 136990,
      "text": "“我好喜欢你” 这些话",
      "endMs": 140070,
      "durationMs": 3080
    },
    {
      "startMs": 140070,
      "text": "我又该对谁说呢 呐",
      "endMs": 143920,
      "durationMs": 3850
    },
    {
      "startMs": 143920,
      "text": "明天 若是身边不再有你",
      "endMs": 147120,
      "durationMs": 3200
    },
    {
      "startMs": 147120,
      "text": "你曾经对我说的“没关系”",
      "endMs": 150190,
      "durationMs": 3070
    },
    {
      "startMs": 150190,
      "text": "还有你赋予我的生存意义",
      "endMs": 153150,
      "durationMs": 2960
    },
    {
      "startMs": 153150,
      "text": "我究竟又该向谁索取呢",
      "endMs": 162820,
      "durationMs": 9670
    },
    {
      "startMs": 162820,
      "text": "好想见你 我真的好想见你",
      "endMs": 181610,
      "durationMs": 18790
    },
    {
      "startMs": 181610,
      "text": "呐 为什么神明大人",
      "endMs": 184810,
      "durationMs": 3200
    },
    {
      "startMs": 184810,
      "text": "要用丝带将相遇与别离",
      "endMs": 188320,
      "durationMs": 3510
    },
    {
      "startMs": 188320,
      "text": "牢牢地紧系在一起之后",
      "endMs": 191990,
      "durationMs": 3670
    },
    {
      "startMs": 191990,
      "text": "当礼物赠予我们?",
      "endMs": 200040,
      "durationMs": 8050
    },
    {
      "startMs": 200040,
      "text": "明天 待到清晨醒来",
      "endMs": 202950,
      "durationMs": 2910
    },
    {
      "startMs": 202950,
      "text": "我要对你道一声“早安”",
      "endMs": 206130,
      "durationMs": 3180
    },
    {
      "startMs": 206130,
      "text": "对你说一句“我回来了”",
      "endMs": 209200,
      "durationMs": 3070
    },
    {
      "startMs": 209200,
      "text": "等着你回我“欢迎回来”",
      "endMs": 212510,
      "durationMs": 3310
    },
    {
      "startMs": 212510,
      "text": "因无法相互理解而争吵",
      "endMs": 215390,
      "durationMs": 2880
    },
    {
      "startMs": 215390,
      "text": "可以说“对不起”来道歉",
      "endMs": 218730,
      "durationMs": 3340
    },
    {
      "startMs": 218730,
      "text": "这些事情每一件都可谓是奇迹",
      "endMs": 221890,
      "durationMs": 3160
    },
    {
      "startMs": 221890,
      "text": "会有这样的感慨 都是因为遇到了你",
      "endMs": 224990,
      "durationMs": 3100
    },
    {
      "startMs": 224990,
      "text": "我啊 我啊 曾经是那么喜欢你",
      "endMs": 231260,
      "durationMs": 6270
    },
    {
      "startMs": 231260,
      "text": "明天 若是还能与你共度",
      "endMs": 234370,
      "durationMs": 3110
    },
    {
