{
  "schemaVersion": 1,
  "foreground": {
    "templateId": "study-current-v3",
    "visibleDuringNoLyric": false,
    "displayTiming": {
      "preRollMs": 180,
      "postRollMs": 420,
      "betweenQrcParts": "keep-line-visible-unhighlighted",
      "overlapPolicy": "clip-to-next-line-preroll"
    },
    "veil": { "mode": "lyric-only", "color": "#000000", "opacity": 0.28 },
    "highlight": { "mode": "token" },
    "textOutline": { "enabled": true, "color": "#000000" }
  },
  "cards": { "fillAlpha": 0.5 },
  "floatingOverlay": { "id": "none", "enabled": false, "persistent": true },
  "alignment": { "owner": "audio", "offsetMs": 0 }
}
