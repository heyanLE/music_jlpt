    {
      "startMs": 179330,
      "text": "不论如何选择或许都是正确答案",
      "endMs": 182890,
      "durationMs": 3560
    },
    {
      "startMs": 182890,
      "text": "却还是在反复斟酌 奇趣无穷",
      "endMs": 185960,
      "durationMs": 3070
    },
    {
      "startMs": 185960,
      "text": "由衷接受自己的选择",
      "endMs": 187960,
      "durationMs": 2000
