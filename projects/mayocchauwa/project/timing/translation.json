  "lines": [
    {
      "startMs": 9040,
      "text": "心中茫然无措 渴望得出正确答案",
      "endMs": 13370,
      "durationMs": 4330
    },
    {
      "startMs": 13370,
      "text": "心中茫然无措 渴望得出正确答案",
      "endMs": 17830,
      "durationMs": 4460
    },
    {
      "startMs": 17830,
      "text": "不论天使恶魔似乎都是共犯",
      "endMs": 22210,
      "durationMs": 4380
    },
    {
      "startMs": 22210,
      "text": "总觉得",
      "endMs": 23270,
      "durationMs": 1060
    },
    {
      "startMs": 23270,
      "text": "这场沟通处处都充满猜忌",
      "endMs": 26620,
      "durationMs": 3350
    },
    {
      "startMs": 26620,
      "text": "根本就没有意义",
      "endMs": 28750,
      "durationMs": 2130
    },
    {
      "startMs": 28750,
      "text": "总是一味地隐藏真心",
      "endMs": 31740,
      "durationMs": 2990
    },
    {
      "startMs": 31740,
      "text": "(反反复复不断探索)",
      "endMs": 33340,
      "durationMs": 1600
    },
    {
      "startMs": 33340,
      "text": "等待最终验证答案",
      "endMs": 35990,
      "durationMs": 2650
    },
    {
      "startMs": 35990,
      "text": "(忍不住一次次碰触)",
      "endMs": 37820,
      "durationMs": 1830
    },
    {
      "startMs": 37820,
      "text": "算是在耍心机吗？",
      "endMs": 40710,
      "durationMs": 2890
    },
    {
      "startMs": 40710,
      "text": "心中满是足以将方糖",
      "endMs": 44310,
      "durationMs": 3600
    },
    {
      "startMs": 44310,
      "text": "融化的甜蜜罪恶感",
      "endMs": 50530,
      "durationMs": 6220
    },
    {
      "startMs": 50530,
      "text": "心中茫然无措 什么才是正确？",
      "endMs": 53190,
      "durationMs": 2660
    },
    {
      "startMs": 53190,
      "text": "虚情假意反而让人轻松",
      "endMs": 55020,
      "durationMs": 1830
    },
    {
      "startMs": 55020,
      "text": "不论如何选择或许都是正确答案",
      "endMs": 58520,
      "durationMs": 3500
    },
    {
      "startMs": 58520,
      "text": "却还是在反复斟酌 奇趣无穷",
      "endMs": 61480,
      "durationMs": 2960
    },
    {
      "startMs": 61480,
      "text": "实在是可笑 这样的自己",
      "endMs": 64150,
      "durationMs": 2670
    },
    {
      "startMs": 64150,
      "text": "依然在层层伪装",
      "endMs": 65810,
      "durationMs": 1660
    },
    {
      "startMs": 65810,
      "text": "不论何时都会觉得有些心有余悸",
      "endMs": 69420,
      "durationMs": 3610
    },
    {
      "startMs": 69420,
      "text": "可还是在反复斟酌 奇趣无穷",
      "endMs": 72510,
      "durationMs": 3090
    },
    {
      "startMs": 72510,
      "text": "必须坚信自己的选择",
      "endMs": 74850,
      "durationMs": 2340
    },
    {
      "startMs": 74850,
      "text": "似乎那些重要的事物",
      "endMs": 78120,
      "durationMs": 3270
    },
    {
      "startMs": 78120,
      "text": "总是若隐若现终会失去",
      "endMs": 81220,
      "durationMs": 3100
    },
    {
      "startMs": 81220,
      "text": "心中茫然无措 渴望得出正确答案",
      "endMs": 85420,
      "durationMs": 4200
    },
    {
      "startMs": 85420,
      "text": "心中茫然无措 渴望得出正确答案",
      "endMs": 90540,
      "durationMs": 5120
    },
    {
      "startMs": 90540,
      "text": "你权当是在消遣？快点坦白",
      "endMs": 92660,
      "durationMs": 2120
    },
    {
      "startMs": 92660,
      "text": "我根本就无法从容应对",
      "endMs": 94870,
      "durationMs": 2210
    },
    {
      "startMs": 94870,
      "text": "不论表里都被操作设定",
      "endMs": 97110,
      "durationMs": 2240
    },
    {
      "startMs": 97110,
      "text": "(或许这是场欺诈游戏)",
      "endMs": 99490,
      "durationMs": 2380
    },
    {
      "startMs": 99490,
      "text": "就算心中感到焦躁难耐",
      "endMs": 101370,
      "durationMs": 1880
    },
    {
      "startMs": 101370,
      "text": "仍愿被你恣意摆布",
      "endMs": 103680,
      "durationMs": 2310
    },
    {
      "startMs": 103680,
      "text": "好感度并不稳定",
      "endMs": 108400,
      "durationMs": 4720
    },
    {
      "startMs": 108400,
      "text": "请让我体会能从幻想中醒来的",
      "endMs": 111920,
      "durationMs": 3520
    },
    {
      "startMs": 111920,
      "text": "那种苦涩的现实感吧",
      "endMs": 118140,
      "durationMs": 6220
    },
    {
      "startMs": 118140,
      "text": "心中茫然无措 我已有所察觉",
      "endMs": 120760,
      "durationMs": 2620
    },
    {
      "startMs": 120760,
      "text": "只要能够由衷地",
      "endMs": 122570,
      "durationMs": 1810
    },
    {
      "startMs": 122570,
      "text": "接受你的甜言蜜语就能得到解脱",
      "endMs": 126210,
      "durationMs": 3640
    },
    {
      "startMs": 126210,
      "text": "让我越陷越深 沉沦其中",
      "endMs": 129190,
      "durationMs": 2980
    },
    {
      "startMs": 129190,
      "text": "实在是可笑 你的点点滴滴",
      "endMs": 131790,
      "durationMs": 2600
    },
    {
      "startMs": 131790,
      "text": "来回盘踞于心间",
      "endMs": 133510,
      "durationMs": 1720
    },
    {
      "startMs": 133510,
      "text": "全都涂抹上如此危险的色彩",
      "endMs": 137990,
      "durationMs": 4480
    },
    {
      "startMs": 137990,
      "text": "让我彻底沦陷 沉沦其中",
      "endMs": 140140,
      "durationMs": 2150
    },
    {
      "startMs": 140140,
      "text": "必须要挣脱出来才行",
      "endMs": 142520,
      "durationMs": 2380
    },
    {
      "startMs": 142520,
      "text": "明明我心中也十分清楚",
      "endMs": 145740,
      "durationMs": 3220
    },
    {
      "startMs": 145740,
      "text": "却径直坠落 彻底沉沦",
      "endMs": 164100,
      "durationMs": 18360
    },
    {
      "startMs": 164100,
      "text": "不论天使恶魔都代表了我真实的感情",
      "endMs": 169190,
      "durationMs": 5090
    },
    {
      "startMs": 169190,
      "text": "(希望能够得到谅解)",
      "endMs": 170750,
      "durationMs": 1560
    },
    {
      "startMs": 170750,
      "text": "让我做个狡猾的人吧",
      "endMs": 174890,
      "durationMs": 4140
    },
    {
      "startMs": 174890,
      "text": "心中茫然无措 什么才是正确？",
      "endMs": 177580,
      "durationMs": 2690
    },
    {
